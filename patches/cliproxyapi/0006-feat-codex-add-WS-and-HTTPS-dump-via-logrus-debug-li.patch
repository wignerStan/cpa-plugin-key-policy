diff --git a/internal/logging/codex_dump.go b/internal/logging/codex_dump.go
new file mode 100644
index 00000000..c5d39049
--- /dev/null
+++ b/internal/logging/codex_dump.go
@@ -0,0 +1,130 @@
+package logging
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"net/http"
+	"runtime"
+	"strings"
+	"sync/atomic"
+
+	log "github.com/sirupsen/logrus"
+	"github.com/tidwall/gjson"
+)
+
+var (
+	codexDumpActive atomic.Bool
+)
+
+// IsLinuxOS reports whether the runtime operating system is Linux.
+func IsLinuxOS() bool {
+	return runtime.GOOS == "linux"
+}
+
+// ConfigureCodexDump sets whether Codex WS/HTTPS dump is enabled via config.
+// Dump is linux-only and default off.
+func ConfigureCodexDump(enabled bool) {
+	if !IsLinuxOS() {
+		codexDumpActive.Store(false)
+		return
+	}
+	codexDumpActive.Store(enabled)
+}
+
+// CodexDumpEnabled reports whether dump capture is active.
+// Returns false on non-Linux OS or when disabled (default off).
+func CodexDumpEnabled() bool {
+	if !IsLinuxOS() {
+		return false
+	}
+	return codexDumpActive.Load()
+}
+
+// CodexDumpFrame logs one websocket text frame (any leg) to logrus at debug level.
+// leg examples: client_in, client_out, upstream_out, upstream_in.
+func CodexDumpFrame(sessionID, leg string, payload []byte) {
+	if !CodexDumpEnabled() {
+		return
+	}
+
+	eventType := ""
+	trimmed := bytesTrimSpace(payload)
+	if len(trimmed) > 0 && json.Valid(trimmed) {
+		eventType = gjson.GetBytes(trimmed, "type").String()
+	}
+
+	log.WithFields(log.Fields{
+		"protocol":   "ws",
+		"session_id": strings.TrimSpace(sessionID),
+		"leg":        strings.TrimSpace(leg),
+		"type":       eventType,
+		"size":       len(payload),
+	}).Debugf("ws dump: %s", string(trimmed))
+}
+
+// CodexDumpBinaryFrame logs a non-text websocket frame to logrus at debug level.
+func CodexDumpBinaryFrame(sessionID, leg string, payload []byte) {
+	if !CodexDumpEnabled() || len(payload) == 0 {
+		return
+	}
+
+	log.WithFields(log.Fields{
+		"protocol":   "ws",
+		"session_id": strings.TrimSpace(sessionID),
+		"leg":        strings.TrimSpace(leg),
+		"binary":     true,
+		"size":       len(payload),
+	}).Debugf("ws binary dump: %s", base64.StdEncoding.EncodeToString(payload))
+}
+
+// CodexDumpHTTPRequest logs an HTTP request (upstream_out or client_in) to logrus at debug level.
+func CodexDumpHTTPRequest(sessionID, leg, method, url string, headers http.Header, body []byte) {
+	if !CodexDumpEnabled() {
+		return
+	}
+
+	trimmed := bytesTrimSpace(body)
+	log.WithFields(log.Fields{
+		"protocol":   "https",
+		"session_id": strings.TrimSpace(sessionID),
+		"leg":        strings.TrimSpace(leg),
+		"method":     strings.TrimSpace(method),
+		"url":        strings.TrimSpace(url),
+		"size":       len(body),
+	}).Debugf("https dump request: %s", string(trimmed))
+}
+
+// CodexDumpHTTPResponse logs an HTTP response metadata/body to logrus at debug level.
+func CodexDumpHTTPResponse(sessionID, leg string, status int, headers http.Header, body []byte) {
+	if !CodexDumpEnabled() {
+		return
+	}
+
+	trimmed := bytesTrimSpace(body)
+	log.WithFields(log.Fields{
+		"protocol":   "https",
+		"session_id": strings.TrimSpace(sessionID),
+		"leg":        strings.TrimSpace(leg),
+		"status":     status,
+		"size":       len(body),
+	}).Debugf("https dump response: %s", string(trimmed))
+}
+
+// CodexDumpHTTPChunk logs an HTTP response chunk (upstream_in or client_out) to logrus at debug level.
+func CodexDumpHTTPChunk(sessionID, leg string, chunk []byte) {
+	if !CodexDumpEnabled() || len(chunk) == 0 {
+		return
+	}
+
+	trimmed := bytesTrimSpace(chunk)
+	log.WithFields(log.Fields{
+		"protocol":   "https",
+		"session_id": strings.TrimSpace(sessionID),
+		"leg":        strings.TrimSpace(leg),
+		"size":       len(chunk),
+	}).Debugf("https dump chunk: %s", string(trimmed))
+}
+
+func bytesTrimSpace(b []byte) []byte {
+	return []byte(strings.TrimSpace(string(b)))
+}
diff --git a/internal/logging/codex_dump_test.go b/internal/logging/codex_dump_test.go
new file mode 100644
index 00000000..09660975
--- /dev/null
+++ b/internal/logging/codex_dump_test.go
@@ -0,0 +1,62 @@
+package logging
+
+import (
+	"bytes"
+	"net/http"
+	"runtime"
+	"strings"
+	"testing"
+
+	log "github.com/sirupsen/logrus"
+)
+
+func TestCodexDumpDefaultsOff(t *testing.T) {
+	ConfigureCodexDump(false)
+	if CodexDumpEnabled() {
+		t.Fatal("CodexDumpEnabled() = true, want false by default")
+	}
+}
+
+func TestCodexDumpStandardLog(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("dump is linux only")
+	}
+
+	var buf bytes.Buffer
+	origOutput := log.StandardLogger().Out
+	origLevel := log.GetLevel()
+	log.SetOutput(&buf)
+	log.SetLevel(log.DebugLevel)
+	defer func() {
+		log.SetOutput(origOutput)
+		log.SetLevel(origLevel)
+		ConfigureCodexDump(false)
+	}()
+
+	ConfigureCodexDump(true)
+	if !CodexDumpEnabled() {
+		t.Fatal("CodexDumpEnabled() = false, want true on linux")
+	}
+
+	CodexDumpFrame("sess-ws", "client_in", []byte(`{"type":"response.create","model":"gpt-6-astra"}`))
+	CodexDumpHTTPRequest("sess-http", "upstream_out", "POST", "https://api.openai.com/v1/responses", http.Header{"Authorization": []string{"Bearer tok"}}, []byte(`{"model":"gpt-6-astra"}`))
+	CodexDumpHTTPResponse("sess-http", "upstream_in", 200, http.Header{"Content-Type": []string{"application/json"}}, []byte(`{"status":"ok"}`))
+	CodexDumpHTTPChunk("sess-http", "upstream_in", []byte("data: chunk\n\n"))
+
+	out := buf.String()
+	if !strings.Contains(out, "ws dump:") {
+		t.Fatalf("expected log output to contain 'ws dump:', got: %s", out)
+	}
+	if !strings.Contains(out, "response.create") {
+		t.Fatalf("expected log output to contain 'response.create', got: %s", out)
+	}
+	if !strings.Contains(out, "https dump request:") {
+		t.Fatalf("expected log output to contain 'https dump request:', got: %s", out)
+	}
+	if !strings.Contains(out, "https dump response:") {
+		t.Fatalf("expected log output to contain 'https dump response:', got: %s", out)
+	}
+	if !strings.Contains(out, "https dump chunk:") {
+		t.Fatalf("expected log output to contain 'https dump chunk:', got: %s", out)
+	}
+}
