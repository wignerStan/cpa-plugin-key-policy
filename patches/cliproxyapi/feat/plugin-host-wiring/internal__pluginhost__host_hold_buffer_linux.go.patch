diff --git a/internal/pluginhost/host_hold_buffer_linux.go b/internal/pluginhost/host_hold_buffer_linux.go
new file mode 100644
index 0000000000000000000000000000000000000000..51fa20112a42e29f877721cfddfd70dbeb05e3fc
--- /dev/null
+++ b/internal/pluginhost/host_hold_buffer_linux.go
@@ -0,0 +1,52 @@
+//go:build cpa_hold_buffer && cgo && linux
+
+package pluginhost
+
+/*
+#include "../../sdk/pluginabi/hold_buffer.h"
+*/
+import "C"
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"unsafe"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginabi"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+const nativeHoldEnabled = true
+
+// The producer pins C-owned memory until this synchronous call returns.
+// The execution callback must not retain the borrowed request slice.
+func nativeHoldCall(entry dynamicHostCallbackEntry, method string, request unsafe.Pointer, n uint64) ([]byte, bool, error) {
+	if method != pluginabi.MethodHostModelExecuteHold {
+		return nil, false, nil
+	}
+	fail := func() ([]byte, bool, error) { return nil, true, fmt.Errorf("invalid native hold contract") }
+	if request == nil || n != uint64(unsafe.Sizeof(C.cliproxy_hold_call_v1{})) {
+		return fail()
+	}
+	native := (*C.cliproxy_hold_call_v1)(request)
+	if native.header.version != 1 || native.header.struct_size != C.uint32_t(n) || native.metadata_len > 1<<20 || native.body.length > 8<<20 || native.body.resource.id == 0 || native.body.resource.generation == 0 || native.body.lease_id == 0 || native.metadata == nil || (native.body.length > 0 && native.local_data == nil) {
+		return fail()
+	}
+	var req rpcHostModelExecutionRequest
+	raw := unsafe.Slice((*byte)(unsafe.Pointer(native.metadata)), int(native.metadata_len))
+	if json.Unmarshal(raw, &req) != nil || req.Stream || req.HostCallbackID == "" || len(req.Body) != 0 {
+		return fail()
+	}
+	ctx := withHostCallbackIdentity(context.Background(), entry.pluginID, entry.instance)
+	bound, err := entry.host.ownedExecutionContext(ctx, req.HostCallbackID)
+	if err != nil {
+		return nil, true, err
+	}
+	if pluginapi.ExecutionCallbacksFrom(bound) == nil {
+		return nil, true, fmt.Errorf("native hold requires a bound execution")
+	}
+	req.Body = unsafe.Slice((*byte)(native.local_data), int(native.body.length))
+	out, err := entry.host.executeHostModelRequest(ctx, req)
+	return out, true, err
+}
