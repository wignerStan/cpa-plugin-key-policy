 func responsesSSENeedsLineBreak(pending, chunk []byte) bool {
+	if bytes.Contains(pending, []byte("codex.response.metadata")) && responsesSSEEventName(pending) == "codex.response.metadata" {
+		// A network chunk can split an SSE field immediately before its colon.
+		// Do not mistake that colon for a new scanner comment line.
+		if len(chunk) > 0 && chunk[0] == ':' {
+			lastLine := pending
+			if end := bytes.LastIndexByte(lastLine, '\n'); end >= 0 {
+				lastLine = lastLine[end+1:]
+			}
+			switch string(lastLine) {
+			case "data", "event", "id", "retry":
+				return false
+			}
+		}
+		if payload, found := responsesSSEDataPayload(pending); found && len(bytes.TrimSpace(payload)) > 0 {
+			if !responsesSSEDataLinesValid(pending) {
+				// Scanner lines can split JSON between data fields, with id/retry
+				// fields between them. Field prefixes inside a JSON string are
+				// instead ordinary byte fragments. A bare colon can be JSON syntax.
+				fieldChunk := bytes.TrimLeft(chunk, " \t")
+				if responsesSSEJSONInsideString(payload) ||
+					!(bytes.HasPrefix(fieldChunk, []byte("data:")) || bytes.HasPrefix(fieldChunk, []byte("event:")) ||
+						bytes.HasPrefix(fieldChunk, []byte("id:")) || bytes.HasPrefix(fieldChunk, []byte("retry:"))) {
+					return false
+				}
+			}
+		}
+	}
 	if len(pending) == 0 || len(chunk) == 0 {
 		return false
 	}
@@ -508,6 +603,22 @@ func responsesSSENeedsLineBreak(pending, chunk []byte) bool {
 	return false
 }
 
+func responsesSSEJSONInsideString(payload []byte) bool {
+	inString, escaped := false, false
+	for _, b := range payload {
+		if escaped {
+			escaped = false
+			continue
+		}
+		if inString && b == '\\' {
+			escaped = true
+		} else if b == '"' {
+			inString = !inString
+		}
+	}
+	return inString
+}
