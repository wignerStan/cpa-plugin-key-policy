+package handlers
+
+import (
+	"context"
+	"testing"
+
+	core "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+func TestAuxiliaryProbeCannotReplaceBusinessCapture(t *testing.T) {
+	h := &BaseAPIHandler{}
+	ids := []string{}
+	h.SetPluginHost(&handlerInterceptorTestHost{interceptRequestAfterAuth: func(_ context.Context, req pluginapi.RequestInterceptRequest) pluginapi.RequestInterceptResponse {
+		ids = append(ids, req.RequestID)
+		return pluginapi.RequestInterceptResponse{Body: append([]byte(nil), req.Body...)}
+	}})
+	capture := &requestAfterAuthCapture{}
+	intercept := h.requestAfterAuthInterceptor(capture, "business-request", "")
+	intercept(context.Background(), core.RequestAfterAuthInterceptRequest{Body: []byte("business")})
+	intercept(pluginapi.WithAuxiliaryExecution(context.Background()), core.RequestAfterAuthInterceptRequest{Body: []byte("private probe")})
+	req, opts := capture.apply(core.Request{}, core.Options{})
+	if string(req.Payload) != "business" || string(opts.OriginalRequest) != "business" || len(ids) != 2 || ids[0] == ids[1] {
+		t.Fatal("probe polluted business plugin context", ids, string(req.Payload))
+	}
+}
