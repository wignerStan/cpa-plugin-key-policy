+// AdmitAuth observes the active scheduler's stable policy. An old scheduler
+// without the optional callback cannot certify that a pool is exhausted.
+func (h *Host) AdmitAuth(ctx context.Context, req pluginapi.SchedulerPickRequest) (ids []string, known bool, err error) {
+	record := h.schedulerRecord()
+	all := func() []string {
+		out := make([]string, 0, len(req.Candidates))
+		for _, candidate := range req.Candidates {
+			out = append(out, candidate.ID)
+		}
+		return out
+	}
+	if record == nil {
+		return all(), true, nil
+	}
+	admission := record.plugin.Capabilities.SchedulerAdmission
+	if admission == nil || !h.recordCurrent(*record) {
+		return nil, false, nil
+	}
+	defer func() {
+		if recovered := recover(); recovered != nil {
+			h.fusePlugin(record.id, "Scheduler.Admit", recovered)
+			ids, known, err = nil, false, fmt.Errorf("scheduler admission callback panicked")
+		}
+	}()
+	req.Plugin = record.meta
+	resp, err := admission.Admit(ctx, req)
+	if err != nil {
+		return nil, false, err
+	}
+	if !h.recordCurrent(*record) || h.isPluginFused(record.id) {
+		return nil, false, fmt.Errorf("scheduler changed during admission")
+	}
+	if !resp.Handled {
+		return all(), true, nil
+	}
+	seen := make(map[string]bool, len(resp.AuthIDs))
+	for _, id := range resp.AuthIDs {
+		if id == "" || seen[id] || !schedulerCandidateExists(req.Candidates, id) {
+			return nil, false, fmt.Errorf("scheduler admission returned an invalid auth id")
+		}
+		seen[id] = true
+	}
+	return append([]string(nil), resp.AuthIDs...), true, nil
+}
+
