From fc60e8894daff1f90f76ae8cbabe6dbd5b6c18ea Mon Sep 17 00:00:00 2001
From: CPA patch maintainer <cpa-patches@localhost>
Date: Mon, 19 Oct 2026 07:49:05 -0700
Subject: [PATCH] feat(plugins): bind guarded execution and native auth
 (internal/watcher/synthesizer/file.go)

---
 internal/watcher/synthesizer/file.go | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/internal/watcher/synthesizer/file.go b/internal/watcher/synthesizer/file.go
index f65d09d42779a3284e40b7df0e659d36eb998019..f89c051be84e0a2423eb2ba22fdd618d7737a57c 100644
--- a/internal/watcher/synthesizer/file.go
+++ b/internal/watcher/synthesizer/file.go
@@ -7,6 +7,7 @@ import (
 	"os"
 	"path/filepath"
 	"runtime"
+	"strconv"
 	"strings"
 
 	"github.com/router-for-me/CLIProxyAPI/v8/internal/auth/codex"
@@ -258,6 +259,18 @@ func synthesizeFileAuths(ctx *SynthesisContext, fullPath string, data []byte) ([
 	}
 	// For codex auth files, extract plan_type from metadata or JWT id_token.
 	if provider == "codex" {
+		if ws, ok := metadata["websockets"]; ok {
+			switch v := ws.(type) {
+			case bool:
+				if v {
+					a.Attributes["websockets"] = "true"
+				}
+			case string:
+				if parsed, errParse := strconv.ParseBool(strings.TrimSpace(v)); errParse == nil && parsed {
+					a.Attributes["websockets"] = "true"
+				}
+			}
+		}
 		if ptRaw, ok := metadata["plan_type"].(string); ok && strings.TrimSpace(ptRaw) != "" {
 			a.Attributes["plan_type"] = strings.TrimSpace(ptRaw)
 		} else if idTokenRaw, ok := metadata["id_token"].(string); ok && strings.TrimSpace(idTokenRaw) != "" {
