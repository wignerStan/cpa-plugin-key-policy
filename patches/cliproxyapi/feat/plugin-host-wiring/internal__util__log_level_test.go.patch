+package util
+
+import (
+	"io"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	log "github.com/sirupsen/logrus"
+)
+
+func TestSetLogLevelFollowsExplicitVerbosity(t *testing.T) {
+	logger := log.StandardLogger()
+	originalOutput := logger.Out
+	originalLevel := logger.GetLevel()
+	logger.SetOutput(io.Discard)
+	t.Cleanup(func() {
+		logger.SetOutput(originalOutput)
+		logger.SetLevel(originalLevel)
+	})
+
+	cases := []struct {
+		name string
+		cfg  config.Config
+		want log.Level
+	}{
+		{name: "info by default", cfg: config.Config{}, want: log.InfoLevel},
+		{name: "debug selected", cfg: config.Config{Debug: true}, want: log.DebugLevel},
+		{name: "trace selected", cfg: config.Config{Trace: true}, want: log.TraceLevel},
+		{
+			name: "capture authorization does not raise level",
+			cfg:  config.Config{SDKConfig: config.SDKConfig{CodexDump: true}},
+			want: log.InfoLevel,
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			logger.SetLevel(log.PanicLevel)
+			SetLogLevel(&tc.cfg)
+			if got := logger.GetLevel(); got != tc.want {
+				t.Fatalf("log level = %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
