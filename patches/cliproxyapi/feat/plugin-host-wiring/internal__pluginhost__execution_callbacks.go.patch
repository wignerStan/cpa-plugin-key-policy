--- /dev/null
+++ b/internal/pluginhost/execution_callbacks.go
@@ -0,0 +1,57 @@
+package pluginhost
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+// A supplied context token must belong to this live plugin instance. Missing
+// tokens retain the legacy background callback behavior for ordinary plugins.
+func (h *Host) ownedExecutionContext(ctx context.Context, id string) (context.Context, error) {
+	bound, err := h.ownedCallbackContext(ctx, id)
+	if err != nil {
+		return nil, err
+	}
+	if err := bound.Err(); err != nil {
+		return nil, err
+	}
+	return bound, nil
+}
+
+// Ownership remains valid until callback cleanup. Legacy model streams detach
+// parent cancellation, while guarded executions additionally require a live ctx.
+func (h *Host) ownedCallbackContext(ctx context.Context, id string) (context.Context, error) {
+	if id == "" {
+		return ctx, nil
+	}
+	bound, owner, instance, ok := h.lookupCallbackContext(id)
+	caller := hostCallbackPluginIDFromContext(ctx)
+	// In-process Go adapters are already trusted and may have no C instance.
+	if !ok || (caller != "" && (owner != caller || instance != hostCallbackInstanceFromContext(ctx))) {
+		return nil, fmt.Errorf("invalid execution context owner")
+	}
+	return bound, nil
+}
+func (h *Host) callHostModelValidate(ctx context.Context, raw []byte) ([]byte, error) {
+	var req struct {
+		HostCallbackID string `json:"host_callback_id"`
+		Receipt        string `json:"receipt"`
+	}
+	if json.Unmarshal(raw, &req) != nil {
+		return nil, fmt.Errorf("invalid receipt request")
+	}
+	bound, err := h.ownedExecutionContext(ctx, req.HostCallbackID)
+	if err != nil {
+		return nil, err
+	}
+	callbacks := pluginapi.ExecutionCallbacksFrom(bound)
+	if callbacks == nil || callbacks.Validate == nil {
+		return nil, fmt.Errorf("no bound execution")
+	}
+	if err = callbacks.Validate(bound, req.Receipt); err != nil {
+		return nil, err
+	}
+	return marshalRPCResult(struct{}{})
+}
