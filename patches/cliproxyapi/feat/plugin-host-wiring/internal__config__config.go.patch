@@ -201,3 +207,20 @@ type Config struct {
 	// Payload defines default and override rules for provider payload parameters.
 	Payload PayloadConfig `yaml:"payload" json:"payload"`
 }
+
+// CodexThreadCooldownConfig is opt-in and independent of native error cooldown.
+// CodexModelGuardTarget narrows API-key guard scope. Fields in a rule are ANDed;
+// values in each field and separate rules are ORed. All matches are exact.
+type CodexModelGuardTarget struct {
+	AuthIDs  []string `yaml:"auth-ids,omitempty" json:"auth-ids,omitempty"`
+	BaseURLs []string `yaml:"base-urls,omitempty" json:"base-urls,omitempty"`
+	Models   []string `yaml:"models,omitempty" json:"models,omitempty"`
+}
+
+type CodexThreadCooldownConfig struct {
+	GuardTargets  []CodexModelGuardTarget `yaml:"guard-targets,omitempty" json:"guard-targets,omitempty"`
+	GuardPlugin   string                  `yaml:"guard-plugin" json:"guard-plugin"`
+	GuardPrefixes []string                `yaml:"guard-prefixes" json:"guard-prefixes"`
+	Enabled       bool                    `yaml:"enabled" json:"enabled"`
+	CacheDir      string                  `yaml:"cache-dir" json:"cache-dir"`
+}
