+package openai
+
+import (
+	"bytes"
+	"context"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/gorilla/websocket"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor/helps"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/api/handlers"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+type interruptDiagnosticRecord struct {
+	sessionID, contextSessionID string
+	ginContext                  bool
+	timeline                    []byte
+}
+
+type interruptDiagnosticExecutor struct {
+	homeInterruptExecutor
+	cfg     *config.Config
+	records chan interruptDiagnosticRecord
+}
+
+func (e *interruptDiagnosticExecutor) InterruptExecutionSession(ctx context.Context, sessionID string, payload []byte) error {
+	helps.RecordAPIWebsocketRequest(ctx, e.cfg, helps.UpstreamRequestLog{Body: payload, Provider: "codex"})
+	ginCtx, _ := ctx.Value("gin").(*gin.Context)
+	var timeline []byte
+	if ginCtx != nil {
+		if value, ok := ginCtx.Get("API_WEBSOCKET_TIMELINE"); ok {
+			timeline, _ = value.([]byte)
+		}
+	}
+	e.records <- interruptDiagnosticRecord{sessionID, coreexecutor.ExecutionSessionID(ctx), ginCtx != nil, bytes.Clone(timeline)}
+	return nil
+}
+
+// The concurrent interrupt reader must retain the same diagnostic context as
+// normal requests. Without it, upstream capture loses attribution and request logs.
+func TestResponsesInterruptDiagnosticContext(t *testing.T) {
+	cfg := &config.Config{SDKConfig: config.SDKConfig{RequestLog: true}}
+	exec := &interruptDiagnosticExecutor{cfg: cfg, records: make(chan interruptDiagnosticRecord, 1)}
+	manager := coreauth.NewManager(nil, nil, nil)
+	manager.SetConfig(cfg)
+	manager.RegisterExecutor(exec)
+	h := NewOpenAIResponsesAPIHandler(handlers.NewBaseAPIHandlers(&cfg.SDKConfig, manager))
+	router := gin.New()
+	router.GET("/v1/responses", h.ResponsesWebsocket)
+	server := httptest.NewServer(router)
+	defer server.Close()
+	client, _, err := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(server.URL, "http")+"/v1/responses", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = client.Close() }()
+	payload := []byte(`{"type":"response.interrupt","response_id":"r1","mode":"discard_partial_items"}`)
+	if err := client.WriteMessage(websocket.TextMessage, payload); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case record := <-exec.records:
+		if record.sessionID == "" || record.contextSessionID != record.sessionID {
+			t.Fatalf("interrupt capture session = %q, want %q", record.contextSessionID, record.sessionID)
+		}
+		if !record.ginContext || !bytes.Contains(record.timeline, []byte("api.websocket.request")) || !bytes.Contains(record.timeline, payload) {
+			t.Fatalf("interrupt missing from request log: %s", record.timeline)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("interrupt callback did not run")
+	}
+}
