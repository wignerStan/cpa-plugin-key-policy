@@ -0,0 +1,36 @@
+package pluginhost
+
+import (
+	"context"
+	"fmt"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+// ExchangeModelGuard never silently bypasses a missing, unloaded or fused guard.
+func (h *Host) ExchangeModelGuard(ctx context.Context, id string, in pluginapi.ModelGuardExchange) (out pluginapi.ModelGuardDecision, err error) {
+	if h == nil {
+		return out, fmt.Errorf("required model guard unavailable")
+	}
+	for _, record := range h.activeRecords() {
+		if record.id != id {
+			continue
+		}
+		guard := record.plugin.Capabilities.CodexModelGuard
+		if guard == nil || h.isPluginFused(id) {
+			break
+		}
+		defer func() {
+			if p := recover(); p != nil {
+				h.fusePlugin(id, "CodexModelGuard.Exchange", p)
+				out = pluginapi.ModelGuardDecision{}
+				err = fmt.Errorf("required model guard panicked")
+			}
+		}()
+		out, err = guard.ExchangeModelGuard(ctx, in)
+		if err == nil && (!h.recordCurrent(record) || h.isPluginFused(id)) {
+			return pluginapi.ModelGuardDecision{}, fmt.Errorf("model guard changed during request")
+		}
+		return out, err
+	}
+	return out, fmt.Errorf("required model guard unavailable")
+}
