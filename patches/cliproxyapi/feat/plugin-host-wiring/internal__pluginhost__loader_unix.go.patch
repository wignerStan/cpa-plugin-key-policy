From 2b989382ed42d7fc44c444c3934770739f44b824 Mon Sep 17 00:00:00 2001
From: CPA patch maintainer <cpa-patches@localhost>
Date: Mon, 19 Oct 2026 08:00:00 -0700
Subject: [PATCH] fix(guard): bound held execution
 (internal/pluginhost/loader_unix.go)

---
 internal/pluginhost/loader_unix.go | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/internal/pluginhost/loader_unix.go b/internal/pluginhost/loader_unix.go
index 636413a88d9c7d7d1f4fbd5b22e164605c71cc0a..5d96c6746c59ec666441e1d7aab2f873a8752cd1 100644
--- a/internal/pluginhost/loader_unix.go
+++ b/internal/pluginhost/loader_unix.go
@@ -202,13 +202,16 @@ func (c *dynamicLibraryClient) Call(ctx context.Context, method string, request
 	}
 	var response C.cliproxy_buffer
 	rc := C.cliproxy_call_plugin(c.api.call, cMethod, (*C.uint8_t)(cRequest), C.size_t(len(request)), &response)
+	if response.ptr != nil {
+		defer C.cliproxy_free_plugin_buffer(c.api.free_buffer, response.ptr, response.len)
+	}
+	if (response.len > 0 && response.ptr == nil) || uint64(response.len) > uint64(1<<31-1) || (method == guardExchangeMethod && response.len > 32<<20) {
+		return nil, fmt.Errorf("plugin response exceeds ABI buffer bound")
+	}
 	var out []byte
 	if response.ptr != nil && response.len > 0 {
 		out = C.GoBytes(response.ptr, C.int(response.len))
 	}
-	if response.ptr != nil {
-		C.cliproxy_free_plugin_buffer(c.api.free_buffer, response.ptr, response.len)
-	}
 	if rc != 0 {
 		if isPluginErrorEnvelope(out) {
 			return out, nil
