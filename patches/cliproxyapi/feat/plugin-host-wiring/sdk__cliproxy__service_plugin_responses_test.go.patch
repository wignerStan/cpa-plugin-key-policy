Date: Mon, 19 Oct 2026 07:49:05 -0700
Subject: [PATCH] feat(plugins): bind guarded execution and native auth
 (sdk/cliproxy/service_plugin_responses_test.go)

---
 sdk/cliproxy/service_plugin_responses_test.go | 109 ++++++++++++++++++
 1 file changed, 109 insertions(+)
 create mode 100644 sdk/cliproxy/service_plugin_responses_test.go

diff --git a/sdk/cliproxy/service_plugin_responses_test.go b/sdk/cliproxy/service_plugin_responses_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..56622d66d0f7363bc0ff6107c353d9cd5dcba152
--- /dev/null
+++ b/sdk/cliproxy/service_plugin_responses_test.go
@@ -0,0 +1,109 @@
+package cliproxy
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor"
+	_ "github.com/router-for-me/CLIProxyAPI/v8/internal/translator"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	core "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/config"
+	translator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+	"github.com/tidwall/gjson"
+)
+
+func TestPluginManagedAuthUsesHTTPSResponsesForExecuteAndStream(t *testing.T) {
+	var calls atomic.Int32
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		if r.TLS == nil || r.Method != http.MethodPost || r.URL.Path != "/v1/responses" || r.Header.Get("Upgrade") != "" {
+			t.Errorf("unexpected transport: %s %s, TLS=%v", r.Method, r.URL.Path, r.TLS != nil)
+			http.Error(w, "Responses required", 400)
+			return
+		}
+		if r.Header.Get("Authorization") != "Bearer local-payg-key" {
+			t.Error("plugin-managed auth was not applied")
+		}
+		body, _ := io.ReadAll(r.Body)
+		if !gjson.GetBytes(body, "input").Exists() || gjson.GetBytes(body, "messages").Exists() || gjson.GetBytes(body, "model").String() != "gpt-6-astra" {
+			t.Errorf("request is not native Responses: %s", body)
+		}
+		w.Header().Set("Content-Type", "text/event-stream")
+		fmt.Fprint(w, "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"resp_payg\",\"object\":\"response\",\"status\":\"completed\",\"model\":\"gpt-6-astra\",\"output\":[{\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"text\":\"ok\"}]}]}}\n\n")
+	}))
+	defer server.Close()
+	s := &Service{cfg: &config.Config{}, coreManager: coreauth.NewManager(nil, nil, nil)}
+	a := &coreauth.Auth{ID: "modeltrace-payg.json", Provider: "modeltrace-payg", Attributes: map[string]string{
+		"base_url": server.URL + "/v1", "api_key": "local-payg-key", "plugin_owner": "cpa-modeltrace",
+		"upstream_protocol": "openai-response",
+	}}
+	s.registerExecutorForAuth(a, false)
+	e, ok := s.coreManager.Executor(a.Provider)
+	if !ok {
+		t.Fatal("missing PAYG Responses executor")
+	}
+	if _, ok := e.(*executor.CodexHTTPProviderExecutor); !ok {
+		t.Fatalf("wrong transport: %T", e)
+	}
+	// API-key scoping happens inside Manager, after executor registration. The
+	// scoped executor must retain its plugin provider and actual wire format.
+	scoped := e.(coreauth.APIKeyConfigExecutor).ForAPIKey()
+	if _, ok := scoped.(*executor.CodexHTTPProviderExecutor); !ok || scoped.Identifier() != a.Provider {
+		t.Fatalf("API-key scoping lost the plugin provider: %T (%q)", scoped, scoped.Identifier())
+	}
+	s.registerExecutorForAuth(a, false)
+	if again, _ := s.coreManager.Executor(a.Provider); again != e {
+		t.Fatal("normal registration replaced the existing transport")
+	}
+	a.Status = coreauth.StatusActive
+	if _, err := s.coreManager.Register(context.Background(), a); err != nil {
+		t.Fatal(err)
+	}
+	GlobalModelRegistry().RegisterClient(a.ID, a.Provider, []*ModelInfo{{ID: "gpt-6-astra"}})
+	t.Cleanup(func() { GlobalModelRegistry().UnregisterClient(a.ID) })
+	ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", server.Client().Transport)
+	req := core.Request{Model: "gpt-6-astra", Payload: []byte(`{"model":"gpt-6-astra","input":"hello"}`)}
+	var intercepted atomic.Int32
+	opts := core.Options{
+		SourceFormat: translator.FormatOpenAIResponse,
+		Metadata: map[string]any{
+			core.PinnedAuthMetadataKey: a.ID,
+		},
+		RequestAfterAuthInterceptor: func(_ context.Context, in core.RequestAfterAuthInterceptRequest) core.RequestAfterAuthInterceptResponse {
+			intercepted.Add(1)
+			if in.ToFormat != translator.FormatCodex {
+				t.Errorf("PAYG interceptor sees wrong wire format: %q", in.ToFormat)
+			}
+			if !gjson.GetBytes(in.Body, "input").Exists() || gjson.GetBytes(in.Body, "messages").Exists() {
+				t.Error("PAYG interceptor must receive the native Responses body")
+			}
+			return core.RequestAfterAuthInterceptResponse{}
+		},
+	}
+	r, err := s.coreManager.Execute(ctx, []string{a.Provider}, req, opts)
+	if err != nil || !bytes.Contains(r.Payload, []byte("resp_payg")) {
+		t.Fatal("non-stream Responses", err, string(r.Payload))
+	}
+	opts.Stream = true
+	stream, err := s.coreManager.ExecuteStream(ctx, []string{a.Provider}, req, opts)
+	if err != nil {
+		t.Fatal("stream Responses", err)
+	}
+	var output []byte
+	for chunk := range stream.Chunks {
+		if chunk.Err != nil {
+			t.Fatal(chunk.Err)
+		}
+		output = append(output, chunk.Payload...)
+	}
+	if calls.Load() != 2 || intercepted.Load() != 2 || !bytes.Contains(output, []byte("response.completed")) {
+		t.Fatal("Responses stream or request interceptor not preserved", calls.Load(), intercepted.Load(), string(output))
+	}
+}
