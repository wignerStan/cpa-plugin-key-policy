Date: Mon, 19 Oct 2026 07:49:05 -0700
Subject: [PATCH] feat(plugins): bind guarded execution and native auth
 (internal/pluginhost/auth_state.go)

---
 internal/pluginhost/auth_state.go | 41 +++++++++++++++++++++++++++++++
 1 file changed, 41 insertions(+)
 create mode 100644 internal/pluginhost/auth_state.go

diff --git a/internal/pluginhost/auth_state.go b/internal/pluginhost/auth_state.go
new file mode 100644
index 0000000000000000000000000000000000000000..b47ec60f367749bf1ee72d0eb664d9576ccb682b
--- /dev/null
+++ b/internal/pluginhost/auth_state.go
@@ -0,0 +1,41 @@
+package pluginhost
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+func (h *Host) SetAuthStateHandler(fn func(context.Context, pluginapi.HostAuthStateRequest) (pluginapi.HostAuthState, error)) {
+	h.mu.Lock()
+	h.authStateHandler = fn
+	h.mu.Unlock()
+}
+func (h *Host) callHostAuthState(ctx context.Context, raw []byte, set bool) ([]byte, error) {
+	var req pluginapi.HostAuthStateRequest
+	if json.Unmarshal(raw, &req) != nil || req.AuthID == "" || req.Model == "" {
+		return nil, fmt.Errorf("invalid auth state request")
+	}
+	var state pluginapi.HostAuthState
+	var err error
+	if set {
+		h.mu.Lock()
+		fn := h.authStateHandler
+		h.mu.Unlock()
+		if fn == nil {
+			return nil, fmt.Errorf("native auth state persistence unavailable")
+		}
+		state, err = fn(ctx, req)
+	} else {
+		manager := h.currentAuthManager()
+		if manager == nil {
+			return nil, fmt.Errorf("auth manager unavailable")
+		}
+		state, err = manager.AuthState(req.AuthID, req.Model)
+	}
+	if err != nil {
+		return nil, err
+	}
+	return marshalRPCResult(state)
+}
