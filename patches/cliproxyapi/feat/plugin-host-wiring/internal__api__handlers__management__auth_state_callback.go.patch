index 0000000000000000000000000000000000000000..bf7e7d5a610cdfbac5231c989e8388f734ea181d
--- /dev/null
+++ b/internal/api/handlers/management/auth_state_callback.go
@@ -0,0 +1,51 @@
+package management
+
+import (
+	"context"
+	"fmt"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+// SetAuthState exposes the native status operation to trusted SDK callbacks.
+// It reuses configuration exclusions and native auth persistence, without a
+// second disable ledger or a new management endpoint.
+func (h *Handler) SetAuthState(ctx context.Context, req pluginapi.HostAuthStateRequest) (pluginapi.HostAuthState, error) {
+	if h == nil || h.authManager == nil {
+		return pluginapi.HostAuthState{}, fmt.Errorf("auth manager unavailable")
+	}
+	h.authStatusMu.Lock()
+	var snapshot configReloadSnapshot
+	state, err := h.authManager.SetAuthDisabled(ctx, req, func(a *coreauth.Auth) error {
+		h.mu.Lock()
+		defer h.mu.Unlock()
+		if h.cfg == nil {
+			return fmt.Errorf("configuration unavailable")
+		}
+		original := h.cfg.CloneForRuntime()
+		handled, err := toggleConfigAPIKeyExcludedAll(h.cfg, a, *req.Disabled)
+		if err != nil {
+			return err
+		}
+		if !handled {
+			return fmt.Errorf("config auth not found")
+		}
+		if err = config.SaveConfigPreserveComments(h.configFilePath, h.cfg, true); err != nil {
+			h.cfg = original
+			return err
+		}
+		snapshot = h.reloadSnapshotConfigLocked()
+		return nil
+	})
+	h.authStatusMu.Unlock()
+	if err != nil {
+		return state, err
+	}
+	if snapshot.cfg != nil {
+		h.reloadConfigAfterManagementSave(ctx, snapshot)
+	} else if a, ok := h.authManager.GetByID(req.AuthID); ok {
+		err = h.invokePostAuthPersistHooks(ctx, []*coreauth.Auth{a})
+	}
+	return state, err
+}
