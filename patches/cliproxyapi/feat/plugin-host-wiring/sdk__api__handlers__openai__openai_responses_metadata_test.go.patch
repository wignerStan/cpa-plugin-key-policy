+func TestCodexMetadataWebsocketWriterPreservesBytesAndTimeline(t *testing.T) {
+	logDir := t.TempDir()
+	requestlogging.ConfigureCodexDump(true, logDir)
+	t.Cleanup(func() { requestlogging.ConfigureCodexDump(false, "") })
+	original := []byte(" \n{\"type\":\"codex.response.metadata\",\"headers\":{\"x-models-etag\":\"catalog\",\"x-codex-turn-state\":\"opaque\"},\"future\":true}\t ")
+	want := [][]byte{original, codexTurnStateMetadataSupplement(original)}
+	result := make(chan error, 1)
+	timeline := &metadataTimeline{}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+		if err != nil {
+			result <- err
+			return
+		}
+		defer conn.Close()
+		result <- writeResponsesWebsocketPayload(newResponsesWebsocketWriter(conn), timeline, "metadata-session", original, time.Now())
+	}))
+	defer server.Close()
+	conn, _, err := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(server.URL, "http"), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	conn.SetReadDeadline(time.Now().Add(5 * time.Second))
+	for i, expected := range want {
+		_, got, err := conn.ReadMessage()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !bytes.Equal(got, expected) {
+			t.Fatalf("frame %d: %q != %q", i, got, expected)
+		}
+	}
+	if err := <-result; err != nil {
+		t.Fatal(err)
+	}
+	if len(timeline.frames) != len(want) {
+		t.Fatalf("timeline frames: %d", len(timeline.frames))
+	}
+	for i, expected := range want {
+		if !bytes.Equal(timeline.frames[i], expected) {
+			t.Fatalf("timeline %d changed", i)
+		}
+	}
+
+	if runtime.GOOS == "linux" {
+		requestlogging.FlushAllStreamBuffers()
+		files, err := os.ReadDir(filepath.Join(logDir, "codex-dumps"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(files) != len(want) {
+			t.Fatalf("capture files = %d, want %d", len(files), len(want))
+		}
+		found := make(map[string]bool)
+		for _, file := range files {
+			data, err := os.ReadFile(filepath.Join(logDir, "codex-dumps", file.Name()))
+			if err != nil {
+				t.Fatal(err)
+			}
+			found[string(data)] = true
+		}
+		for _, expected := range want {
+			if !found[string(expected)] {
+				t.Fatalf("actual outgoing frame missing from capture: %q", expected)
+			}
+		}
+	}
+}
