+func TestCodexMetadataSSEEmptyDataTailWithNextFramePreservesBytes(t *testing.T) {
+	payload := `{"type":"codex.response.metadata","headers":{"x-codex-turn-state":"opaque"}}`
+	for _, newline := range []string{"\n", "\r\n"} {
+		for _, tail := range []string{"data:", "data: ", "data:\t"} {
+			original := []byte("event: codex.response.metadata" + newline + "data: " + payload + newline + tail + newline + newline)
+			completed := []byte("event: response.completed" + newline + "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"r1\",\"status\":\"completed\",\"output\":[]}}" + newline + newline)
+			wire := bytes.Join([][]byte{original, completed}, nil)
+			for _, native := range []bool{false, true} {
+				want := completed
+				if native {
+					want = bytes.Join([][]byte{original, responsesSSEFrameWithEventAndData("response.metadata", codexTurnStateMetadataSupplement([]byte(payload))), completed}, nil)
+				}
+				for split := bytes.Index(original, []byte("data:")) + len("data:"); split <= len(original); split++ {
+					var out bytes.Buffer
+					framer := &responsesSSEFramer{isCodexClient: native}
+					framer.WriteChunk(&out, wire[:split])
+					framer.WriteChunk(&out, wire[split:])
+					framer.Flush(&out)
+					if framer.terminalEvent != "response.completed" || !bytes.Equal(out.Bytes(), want) {
+						t.Fatalf("empty data tail changed: native=%t newline=%q tail=%q split=%d terminal=%q actual=%q want=%q", native, newline, tail, split, framer.terminalEvent, out.Bytes(), want)
+					}
+				}
+			}
+		}
+	}
+}
