+func TestCodexMetadataSSEMultilineScannerLinesReachCompletion(t *testing.T) {
+	completed := "event: response.completed\ndata: {\"type\":\"response.completed\",\"response\":{\"id\":\"r1\",\"status\":\"completed\",\"output\":[]}}\n\n"
+	for _, native := range []bool{false, true} {
+		for _, data := range []string{
+			"data:\n\n",
+			"data: {\"type\":\"codex.response.metadata\",\ndata: \"headers\":{\"x-codex-turn-state\":\"opaque\"}}\n\n",
+			"data: {\"type\":\"codex.response.metadata\",\ndata: \"headers\":{\ndata: \"x-codex-turn-state\":\"opaque\"}}\n\n",
+			"data: {\"type\":\"codex.response.metadata\",\nid: metadata-1\ndata: \"headers\":{\nretry: 1000\ndata: \"x-codex-turn-state\":\"opaque\"}}\n\n",
+			"data:\ndata: {\"type\":\"codex.response.metadata\",\ndata:\ndata: \"headers\":{\"x-codex-turn-state\":\"opaque\"}}\n\n",
+			"data: {\"type\":\"codex.response.metadata\",\ndata: \"headers\":{\"x-codex-turn-state\":\"opaque\"}}\ndata:\n\n",
+		} {
+			t.Run(fmt.Sprintf("native=%t/bytes=%d", native, len(data)), func(t *testing.T) {
+				metadata := "event: codex.response.metadata\n" + data
+				var out bytes.Buffer
+				framer := &responsesSSEFramer{isCodexClient: native}
+				scanner := bufio.NewScanner(strings.NewReader(metadata + completed))
+				for scanner.Scan() {
+					if len(scanner.Bytes()) > 0 {
+						framer.WriteChunk(&out, scanner.Bytes())
+					}
+				}
+				if err := scanner.Err(); err != nil {
+					t.Fatal(err)
+				}
+				framer.Flush(&out)
+				want := completed
+				if native {
+					payload, _ := responsesSSEDataPayload([]byte(metadata))
+					want = metadata
+					if supplement := codexTurnStateMetadataSupplement(payload); len(supplement) > 0 {
+						want += string(responsesSSEFrameWithEventAndData("response.metadata", supplement))
+					}
+					want += completed
+				}
+				if framer.terminalEvent != "response.completed" || !bytes.Equal(out.Bytes(), []byte(want)) {
+					t.Fatalf("multiline scanner frames changed: terminal=%q frames=%d bytes=%d want_bytes=%d", framer.terminalEvent, framer.dataFrames, out.Len(), len(want))
+				}
+			})
+		}
+	}
+}
