+func TestCodexTurnStateMetadataSupplement(t *testing.T) {
+	for _, test := range []struct{ name, payload, state string }{
+		{"etag_and_state", ` {"type":"codex.response.metadata","headers":{"x-models-etag":"W/\"catalog\"","x-codex-turn-state":"opaque"},"future":true} `, `"opaque"`},
+		{"etag_only", `{"type":"codex.response.metadata","headers":{"x-models-etag":"catalog"}}`, ""},
+		{"mixed_case_array", `{"type":"codex.response.metadata","headers":{"X-Codex-Turn-State":[["opaque"],"later"],"x-models-etag":"catalog"}}`, `"opaque"`},
+		{"array_first_only", `{"type":"codex.response.metadata","headers":{"x-codex-turn-state":[null,"later"]}}`, ""},
+		{"empty_array", `{"type":"codex.response.metadata","headers":{"x-codex-turn-state":[]}}`, ""},
+		{"empty_string", `{"type":"codex.response.metadata","headers":{"x-codex-turn-state":""}}`, ""},
+		{"whitespace_only", `{"type":"codex.response.metadata","headers":{"x-codex-turn-state":"  \t"}}`, ""},
+		{"opaque_spacing", `{"type":"codex.response.metadata","headers":{"x-codex-turn-state":" opaque "}}`, `" opaque "`},
+		{"invalid_number", `{"type":"codex.response.metadata","headers":{"x-codex-turn-state":42}}`, ""},
+		{"invalid_object", `{"type":"codex.response.metadata","headers":{"x-codex-turn-state":{"opaque":true}}}`, ""},
+		{"malformed_json", `{"type":"codex.response.metadata","headers":{"x-codex-turn-state":"opaque"}`, ""},
+		{"canonical", `{"type":"response.metadata","headers":{"x-codex-turn-state":"opaque"}}`, ""},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			payload := []byte(test.payload)
+			before := bytes.Clone(payload)
+			got := codexTurnStateMetadataSupplement(payload)
+			if !bytes.Equal(payload, before) {
+				t.Fatal("provider bytes changed")
+			}
+			if test.state == "" {
+				if got != nil {
+					t.Fatalf("unexpected extra frame: %s", got)
+				}
+				return
+			}
+			want := `{"type":"response.metadata","headers":{"x-codex-turn-state":` + test.state + `}}`
+			if string(got) != want {
+				t.Fatalf("supplement = %s, want %s", got, want)
+			}
+		})
+	}
+}
