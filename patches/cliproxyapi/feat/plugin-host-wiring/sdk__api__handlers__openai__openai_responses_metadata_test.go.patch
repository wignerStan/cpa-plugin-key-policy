+// Exercise the actual Gin handler, auth manager and native executor over TCP.
+func TestCodexMetadataWebsocketHandlerPreservesOrder(t *testing.T) {
+	frames := [][]byte{
+		[]byte(`{"type":"codex.response.metadata","headers":{"x-models-etag":"W/\"catalog\"","x-codex-turn-state":"opaque"},"future":[1,true]}`),
+		[]byte(`{"type":"codex.response.metadata","headers":{"x-models-etag":"catalog"}}`),
+		[]byte(`{"type":"codex.response.metadata","headers":{"x-codex-turn-state":[null,"later"]}}`),
+		[]byte(`{"type":"response.metadata","headers":{"x-codex-turn-state":"canonical"},"future":true}`),
+		[]byte(`{"type":"response.created","response":{"id":"metadata-response","output":[]}}`),
+		[]byte(`{"type":"response.completed","response":{"id":"metadata-response","output":[]}}`),
+	}
+	var connections atomic.Int32
+	result := make(chan error, 1)
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		connections.Add(1)
+		result <- func() error {
+			if r.Header.Get("Authorization") != "Bearer metadata-key" {
+				return fmt.Errorf("wrong upstream credential")
+			}
+			c, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+			if err != nil {
+				return err
+			}
+			defer func() { _ = c.Close() }()
+			_ = c.SetReadDeadline(time.Now().Add(5 * time.Second))
+			if _, _, err := c.ReadMessage(); err != nil {
+				return err
+			}
+			for _, frame := range frames {
+				if err := c.WriteMessage(websocket.TextMessage, frame); err != nil {
+					return err
+				}
+			}
+			_, _, err = c.ReadMessage()
+			if err == nil {
+				return fmt.Errorf("unexpected follow-up request")
+			}
+			return nil
+		}()
+	}))
+	defer upstream.Close()
+	cfg := &config.Config{}
+	manager := coreauth.NewManager(nil, nil, nil)
+	manager.SetConfig(cfg)
+	manager.RegisterExecutor(runtimeexecutor.NewCodexAutoExecutor(cfg))
+	const authID = "metadata-order-auth"
+	if _, err := manager.Register(context.Background(), &coreauth.Auth{ID: authID, Provider: "codex", Status: coreauth.StatusActive, Attributes: map[string]string{"api_key": "metadata-key", "base_url": upstream.URL, "websockets": "true"}}); err != nil {
+		t.Fatal(err)
+	}
+	registry.GetGlobalRegistry().RegisterClient(authID, "codex", []*registry.ModelInfo{{ID: "metadata-order-model"}})
+	defer registry.GetGlobalRegistry().UnregisterClient(authID)
+	h := NewOpenAIResponsesAPIHandler(handlers.NewBaseAPIHandlers(&cfg.SDKConfig, manager))
+	router := gin.New()
+	router.GET("/v1/responses", h.ResponsesWebsocket)
+	downstream := httptest.NewServer(router)
+	defer downstream.Close()
+	c, _, err := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(downstream.URL, "http")+"/v1/responses", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = c.Close() }()
+	_ = c.SetReadDeadline(time.Now().Add(5 * time.Second))
+	if err := c.WriteMessage(websocket.TextMessage, []byte(`{"type":"response.create","model":"metadata-order-model","input":[]}`)); err != nil {
+		t.Fatal(err)
+	}
+	want := [][]byte{frames[0], codexTurnStateMetadataSupplement(frames[0]), frames[1], frames[2], frames[3]}
+	for i, expected := range want {
+		_, got, err := c.ReadMessage()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !bytes.Equal(got, expected) {
+			t.Fatalf("frame %d changed/order wrong: %s", i, got)
+		}
+	}
+	for _, event := range []string{"response.created", "response.completed"} {
+		_, got, err := c.ReadMessage()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if gjson.GetBytes(got, "type").String() != event {
+			t.Fatalf("unexpected extra metadata frame: %s", got)
+		}
+	}
+	_ = c.Close()
+	select {
+	case err := <-result:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("upstream cleanup stalled")
+	}
+	if connections.Load() != 1 {
+		t.Fatal("connection changed")
+	}
+}
