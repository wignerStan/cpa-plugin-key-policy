+// Native HTTP execution delivers scanner lines without their newline delimiters.
+// A complete private metadata frame must not retain later business events.
+func TestCodexMetadataSSEScannerLinesReachCompletion(t *testing.T) {
+	metadata := `{"type":"codex.response.metadata","headers":{"x-codex-turn-state":"opaque"}}`
+	for _, native := range []bool{false, true} {
+		for _, eventFields := range []bool{false, true} {
+			for _, trailingID := range []bool{false, true} {
+				name := fmt.Sprintf("native=%t/event_fields=%t/trailing_id=%t", native, eventFields, trailingID)
+				t.Run(name, func(t *testing.T) {
+					metadataFrame := "event: codex.response.metadata\ndata: " + metadata
+					if trailingID {
+						metadataFrame += "\nid: metadata-1"
+					}
+					metadataFrame += "\n\n"
+					var business bytes.Buffer
+					for _, event := range []struct{ name, payload string }{
+						{"response.created", `{"type":"response.created","response":{"id":"r1","status":"in_progress"}}`},
+						{"response.output_item.done", `{"type":"response.output_item.done","output_index":0,"item":{"id":"call1","type":"function_call","call_id":"c1","name":"fixture","arguments":"{}"}}`},
+						{"response.completed", `{"type":"response.completed","response":{"id":"r1","status":"completed","output":[{"id":"call1","type":"function_call","call_id":"c1","name":"fixture","arguments":"{}"}]}}`},
+					} {
+						if eventFields {
+							business.WriteString("event: " + event.name + "\n")
+						}
+						business.WriteString("data: " + event.payload + "\n\n")
+					}
+					wire := "event: codex.rate_limits\ndata: {\"type\":\"codex.rate_limits\"}\n\n" + metadataFrame + business.String()
+					var out bytes.Buffer
+					framer := &responsesSSEFramer{isCodexClient: native}
+					scanner := bufio.NewScanner(strings.NewReader(wire))
+					for scanner.Scan() {
+						if len(scanner.Bytes()) > 0 {
+							framer.WriteChunk(&out, scanner.Bytes())
+						}
+					}
+					if err := scanner.Err(); err != nil {
+						t.Fatal(err)
+					}
+					framer.Flush(&out)
+					want := business.String()
+					if native {
+						supplement := responsesSSEFrameWithEventAndData("response.metadata", codexTurnStateMetadataSupplement([]byte(metadata)))
+						want = metadataFrame + string(supplement) + want
+					}
+					if framer.terminalEvent != "response.completed" || !bytes.Equal(out.Bytes(), []byte(want)) {
+						t.Fatalf("scanner lines lost or changed frames: terminal=%q frames=%d bytes=%d want_bytes=%d", framer.terminalEvent, framer.dataFrames, out.Len(), len(want))
+					}
+				})
+			}
+		}
+	}
+}
