From 49a0da2dcfd1b3fb6083088afa8797038d32eb41 Mon Sep 17 00:00:00 2001
From: CPA patch maintainer <cpa-patches@localhost>
Date: Tue, 20 Oct 2026 05:00:00 -0700
Subject: [PATCH] feat(guard): isolate verification HTTP sockets
 (internal/pluginhost/host_callbacks.go)

---
diff --git a/internal/pluginhost/host_callbacks.go b/internal/pluginhost/host_callbacks.go
index 4af872a..694cfd3 100644
--- a/internal/pluginhost/host_callbacks.go
+++ b/internal/pluginhost/host_callbacks.go
@@ -3,15 +3,19 @@ package pluginhost
 import (
 	"context"
 	"encoding/json"
+	"errors"
 	"fmt"
 	"net/http"
 	"strings"
 	"sync/atomic"
+	"time"
 
 	"github.com/router-for-me/CLIProxyAPI/v8/internal/clienterror"
 	"github.com/router-for-me/CLIProxyAPI/v8/internal/interfaces"
 	"github.com/router-for-me/CLIProxyAPI/v8/internal/logging"
 	"github.com/router-for-me/CLIProxyAPI/v8/sdk/api/handlers"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/httptransport"
 	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginabi"
 	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
 	"github.com/router-for-me/CLIProxyAPI/v8/sdk/proxyutil"
@@ -145,6 +149,8 @@ func (h *Host) callFromPlugin(ctx context.Context, method string, request []byte
 		return nil, fmt.Errorf("host plugin callback instance is closed")
 	}
 	switch method {
+	case "host.model.validate":
+		return h.callHostModelValidate(ctx, request)
 	case pluginabi.MethodHostModelExecute:
 		return h.callHostModelExecute(ctx, request)
 	case pluginabi.MethodHostModelExecuteStream:
@@ -152,7 +158,7 @@ func (h *Host) callFromPlugin(ctx context.Context, method string, request []byte
 	case pluginabi.MethodHostModelStreamRead:
 		return h.callHostModelStreamRead(ctx, request)
 	case pluginabi.MethodHostModelStreamClose:
-		return h.callHostModelStreamClose(request)
+		return h.callHostModelStreamCloseContext(ctx, request)
 	case pluginabi.MethodHostHTTPDo:
 		return h.callHostHTTPDo(ctx, request)
 	case pluginabi.MethodHostHTTPDoStream:
@@ -171,6 +177,10 @@ func (h *Host) callFromPlugin(ctx context.Context, method string, request []byte
 		return h.callHostStreamClose(request)
 	case pluginabi.MethodHostLog:
 		return h.callHostLog(ctx, request)
+	case "host.auth.state_get":
+		return h.callHostAuthState(ctx, request, false)
+	case "host.auth.state_set":
+		return h.callHostAuthState(ctx, request, true)
 	case pluginabi.MethodHostAuthList:
 		return h.callHostAuthList(ctx, request)
 	case pluginabi.MethodHostAuthGet:
@@ -409,22 +419,93 @@ func (h *Host) callHostModelExecute(ctx context.Context, request []byte) ([]byte
 	if errUnmarshal := json.Unmarshal(request, &req); errUnmarshal != nil {
 		return nil, fmt.Errorf("decode host model execution request: %w", errUnmarshal)
 	}
+	return h.executeHostModelRequest(ctx, req)
+}
+
+// Native Execute assembles a small fingerprint result from a larger SSE stream.
+// Bound the wire read separately from the result copied into the plugin reply.
+const hostInspectionResponseLimit = 256 << 10
+const hostInspectionWireLimit = 8 << 20
+
+// Private side/steer requests cannot hold the caller behind an endless SSE
+// response. The caller's earlier cancellation or deadline always wins.
+// High-effort responses can legitimately take more than ninety seconds. Keep
+// each auxiliary call below a five-minute caller phase, with scoring headroom.
+const hostAuxiliaryExecutionTimeout = 4 * time.Minute
+
+func (h *Host) executeHostModelRequest(ctx context.Context, req rpcHostModelExecutionRequest) ([]byte, error) {
 	if req.Stream {
 		return nil, fmt.Errorf("host.model.execute requires stream=false")
 	}
 	if errProxy := validateHostModelProxy(req.ProxyURL); errProxy != nil {
 		return nil, errProxy
 	}
+	callbackCtx, errContext := h.ownedExecutionContext(ctx, req.HostCallbackID)
+	if errContext != nil {
+		return nil, errContext
+	}
+	if bound := pluginapi.ExecutionCallbacksFrom(callbackCtx); bound != nil {
+		if req.SingleAttempt {
+			callbackCtx = httptransport.WithResponseBodyLimit(callbackCtx, hostInspectionWireLimit)
+		}
+		executionCtx := callbackCtx
+		if req.Auxiliary {
+			var cancel context.CancelFunc
+			executionCtx, cancel = context.WithTimeout(callbackCtx, hostAuxiliaryExecutionTimeout)
+			defer cancel()
+		}
+		resp, err := bound.Execute(executionCtx, req.HostModelExecutionRequest)
+		if callbackCtx.Err() != nil {
+			return nil, callbackCtx.Err()
+		}
+		if req.Auxiliary && errors.Is(executionCtx.Err(), context.DeadlineExceeded) {
+			return marshalRPCResult(pluginapi.HostModelExecutionResponse{Error: "auxiliary_timeout"})
+		}
+		if err != nil {
+			if response, ok := modelGuardValidationFailure(err); ok {
+				return marshalRPCResult(response)
+			}
+			return nil, err
+		}
+		if req.SingleAttempt && len(resp.Body) > hostInspectionResponseLimit {
+			return nil, fmt.Errorf("inspection result exceeds byte limit: %w", httptransport.ErrResponseBodyTooLarge)
+		}
+		return marshalRPCResult(resp)
+	}
+	if req.HTTPTransport != "" {
+		return nil, fmt.Errorf("HTTP transport isolation requires bound Codex execution")
+	}
 	executor := h.currentModelExecutor()
 	if executor == nil {
 		return nil, fmt.Errorf("host model executor is unavailable")
 	}
 	skipPluginID := h.callbackCallerPluginID(ctx, req.HostCallbackID)
-	ctx = h.resolveCallbackContext(req.HostCallbackID, ctx)
+	ctx = pluginapi.WithCallingPlugin(h.resolveCallbackContext(req.HostCallbackID, ctx), skipPluginID)
+	if req.SingleAttempt {
+		if req.AuthID == "" {
+			return nil, fmt.Errorf("single attempt requires a pinned auth")
+		}
+		operation, err := h.acquireHostHTTPOperation(ctx, req.HostCallbackID, req.OperationID)
+		if err != nil {
+			return nil, err
+		}
+		defer operation.finish()
+		ctx = pluginapi.WithCallingPlugin(coreauth.WithSingleExecutionAttempt(operation.ctx), skipPluginID)
+		ctx = httptransport.WithResponseBodyLimit(ctx, hostInspectionWireLimit)
+	}
 	resp, errMsg := executor.ExecuteModel(ctx, modelExecutionRequestFromPlugin(req.HostModelExecutionRequest, skipPluginID))
 	if errMsg != nil {
+		if errors.Is(errMsg.Error, httptransport.ErrResponseBodyTooLarge) {
+			return nil, errMsg.Error
+		}
+		if req.SingleAttempt && ctx.Err() == nil && coreauth.HasUpstreamAttempt(errMsg.Error) {
+			return marshalRPCResult(pluginapi.HostModelExecutionResponse{StatusCode: errMsg.StatusCode, Error: "upstream_execution_failed"})
+		}
 		return nil, modelExecutionError(errMsg)
 	}
+	if req.SingleAttempt && len(resp.Body) > hostInspectionResponseLimit {
+		return nil, fmt.Errorf("inspection result exceeds byte limit: %w", httptransport.ErrResponseBodyTooLarge)
+	}
 	return marshalRPCResult(pluginapi.HostModelExecutionResponse{
 		StatusCode: resp.StatusCode,
 		Headers:    cloneHeader(resp.Headers),
@@ -539,3 +620,13 @@ func (h *Host) callHostLog(ctx context.Context, request []byte) ([]byte, error)
 	}
 	return marshalRPCResult(rpcEmptyResponse{})
 }
+
+// Internal typed error adapter; no SDK/ABI change and no string matching of
+// arbitrary upstream error messages. The plugin owns the bounded retry budget.
+func modelGuardValidationFailure(err error) (pluginapi.HostModelExecutionResponse, bool) {
+	var marked interface{ ModelGuardRetryReason() string }
+	if errors.As(err, &marked) && marked.ModelGuardRetryReason() == "upstream_compact_validation_failed" {
+		return pluginapi.HostModelExecutionResponse{StatusCode: http.StatusBadGateway, Error: "upstream_compact_validation_failed"}, true
+	}
+	return pluginapi.HostModelExecutionResponse{}, false
+}
