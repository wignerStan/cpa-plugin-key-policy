From 3464f6496046e554cd536d8904bb09a5f8546594 Mon Sep 17 00:00:00 2001
From: CPA patch maintainer <cpa-patches@localhost>
Date: Mon, 19 Oct 2026 07:49:05 -0700
Subject: [PATCH] feat(plugins): bind guarded execution and native auth
 (sdk/api/handlers/handlers_context.go)

---
 sdk/api/handlers/handlers_context.go | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/sdk/api/handlers/handlers_context.go b/sdk/api/handlers/handlers_context.go
index e95fca91d26e8abb4617d30f016d41bd89177752..29bdf4c1b112166f78cd7394c3841d2009806ef0 100644
--- a/sdk/api/handlers/handlers_context.go
+++ b/sdk/api/handlers/handlers_context.go
@@ -7,6 +7,7 @@ import (
 	"sync"
 
 	"github.com/gin-gonic/gin"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
 	"golang.org/x/net/context"
 )
 
@@ -138,7 +139,13 @@ func WithExecutionSessionID(ctx context.Context, sessionID string) context.Conte
 	if ctx == nil {
 		ctx = context.Background()
 	}
-	return context.WithValue(ctx, executionSessionContextKey{}, sessionID)
+	ctx = context.WithValue(ctx, executionSessionContextKey{}, sessionID)
+	return cliproxyexecutor.WithExecutionSessionID(ctx, sessionID)
+}
+
+// ExecutionSessionID returns the execution session ID from ctx when present.
+func ExecutionSessionID(ctx context.Context) string {
+	return cliproxyexecutor.ExecutionSessionID(ctx)
 }
 
 // WithDisallowFreeAuth returns a child context that requests skipping known free-tier credentials.
