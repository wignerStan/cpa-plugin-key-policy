+package management
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/watcher/synthesizer"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+func TestPluginAuthDisablePersistsNativeConfigExclusion(t *testing.T) {
+	cfg := &config.Config{CodexKey: []config.CodexKey{{APIKey: "test-key", BaseURL: "https://example.invalid/v1", ExcludedModels: []string{"blocked-model"}}}}
+	path := filepath.Join(t.TempDir(), "config.yaml")
+	if err := os.WriteFile(path, []byte("config-version: 8\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := config.SaveConfigPreserveComments(path, cfg, true); err != nil {
+		t.Fatal(err)
+	}
+	id, _ := synthesizer.NewStableIDGenerator().Next("codex:apikey", "test-key", "https://example.invalid/v1", "", "", "")
+	m := coreauth.NewManager(nil, nil, nil)
+	_, err := m.Register(context.Background(), &coreauth.Auth{ID: id, Provider: "codex", Status: coreauth.StatusActive, Attributes: map[string]string{"source": "config:codex[test]", "api_key": "test-key", "base_url": "https://example.invalid/v1"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := NewHandler(cfg, path, m)
+	reloads := 0
+	h.SetConfigReloadHook(func(context.Context, *config.Config) { reloads++ })
+	state, err := m.AuthState(id, "model")
+	if err != nil {
+		t.Fatal(err)
+	}
+	disabled := true
+	state, err = h.SetAuthState(context.Background(), pluginapi.HostAuthStateRequest{AuthID: id, Model: "model", Version: state.Version, Disabled: &disabled})
+	if err != nil || !state.Disabled || reloads != 1 {
+		t.Fatal("native disable/reload failed", state, reloads, err)
+	}
+	loaded, err := config.LoadConfig(path)
+	if err != nil || len(loaded.CodexKey) != 1 {
+		t.Fatal(err)
+	}
+	found := false
+	for _, model := range loaded.CodexKey[0].ExcludedModels {
+		if model == "*" {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatal("disable not persisted in native excluded-models")
+	}
+}
