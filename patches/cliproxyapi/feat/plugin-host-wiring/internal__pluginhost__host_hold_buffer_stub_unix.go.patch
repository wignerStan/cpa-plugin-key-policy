+
+package pluginhost
+
+import (
+	"fmt"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginabi"
+	"unsafe"
+)
+
+const nativeHoldEnabled = false
+
+func nativeHoldCall(_ dynamicHostCallbackEntry, method string, _ unsafe.Pointer, _ uint64) ([]byte, bool, error) {
+	if method == pluginabi.MethodHostModelExecuteHold {
+		return nil, true, fmt.Errorf("native hold buffer support was not built")
+	}
+	return nil, false, nil
