diff --git a/internal/pluginhost/test_helpers_test.go b/internal/pluginhost/test_helpers_test.go
index fb199f722d893066b2974b4063e9e08596eb860a..fb3cdfe3f9b2dc694a3175ad620b7cce6777ab29 100644
