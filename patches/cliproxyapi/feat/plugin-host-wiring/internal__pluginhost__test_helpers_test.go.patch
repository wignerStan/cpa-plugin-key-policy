@@ -153,6 +153,19 @@ func (l *testSymbolLookup) Call(ctx context.Context, method string, request []by
 			return nil, errPick
 		}
 		return marshalRPCResult(resp)
+	case pluginabi.MethodSchedulerAdmit:
+		if l.active.Capabilities.SchedulerAdmission == nil {
+			return nil, fmt.Errorf("missing scheduler admission")
+		}
+		var req pluginapi.SchedulerPickRequest
+		if err := json.Unmarshal(request, &req); err != nil {
+			return nil, err
+		}
+		resp, err := l.active.Capabilities.SchedulerAdmission.Admit(ctx, req)
+		if err != nil {
+			return nil, err
+		}
+		return marshalRPCResult(resp)
 	case pluginabi.MethodModelRoute:
 		if l.active.Capabilities.ModelRouter == nil {
 			return nil, fmt.Errorf("missing model router")
