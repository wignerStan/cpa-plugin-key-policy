+package pluginhost
+
+import (
+	"context"
+	"fmt"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+	"testing"
+)
+
+type guardFunc func(context.Context, pluginapi.ModelGuardExchange) (pluginapi.ModelGuardDecision, error)
+
+func (f guardFunc) ExchangeModelGuard(ctx context.Context, in pluginapi.ModelGuardExchange) (pluginapi.ModelGuardDecision, error) {
+	return f(ctx, in)
+}
+func TestRequiredGuardNeverUsesAnotherPluginOrFallsOpen(t *testing.T) {
+	for _, mode := range []string{"missing", "error", "panic", "accept"} {
+		t.Run(mode, func(t *testing.T) {
+			calls := 0
+			id := "guard"
+			if mode == "missing" {
+				id = "other"
+			}
+			h := newHostWithRecords(capabilityRecord{id: id, plugin: pluginapi.Plugin{Capabilities: pluginapi.Capabilities{CodexModelGuard: guardFunc(func(context.Context, pluginapi.ModelGuardExchange) (pluginapi.ModelGuardDecision, error) {
+				calls++
+				switch mode {
+				case "panic":
+					panic("failure")
+				case "error":
+					return pluginapi.ModelGuardDecision{}, fmt.Errorf("failed")
+				}
+				return pluginapi.ModelGuardDecision{Action: "accept"}, nil
+			})}}})
+			d, e := h.ExchangeModelGuard(context.Background(), "guard", pluginapi.ModelGuardExchange{Version: 1})
+			if mode == "accept" {
+				if e != nil || d.Action != "accept" {
+					t.Fatal(e)
+				}
+				return
+			}
+			if e == nil || d.Action == "accept" {
+				t.Fatal("required guard failed open")
+			}
+			if mode == "missing" && calls != 0 {
+				t.Fatal("another guard was used")
+			}
+			if mode == "panic" {
+				if !h.isPluginFused(id) {
+					t.Fatal("panic did not fuse")
+				}
+				if _, e = h.ExchangeModelGuard(context.Background(), id, pluginapi.ModelGuardExchange{}); e == nil {
+					t.Fatal("fused guard bypassed")
+				}
+			}
+		})
+	}
+}
