+func TestCodexDumpHTTPViewRedactsHeadersAndPayload(t *testing.T) {
+	output := captureCodexDumpLogs(t)
+	log.SetLevel(log.TraceLevel)
+	ConfigureCodexDump(false, t.TempDir())
+	body := []byte(`{"api_key":"body-secret","scheme":"Bearer","routing_token":"opaque-public","prompt":"private prompt text"}`)
+	headers := http.Header{
+		"Authorization":    []string{"Bearer header-secret"},
+		"Content-Type":     []string{"application/json"},
+		"X-Correlation-Id": []string{"a%252Fb"},
+		"CF-Ray":           []string{"8e12345-SJC"},
+		"Cookie":           []string{"__cf_bm=lb123; __oailb=node-123.456; session=user_secret; access_token=secret_at_123"},
+		"Set-Cookie":       []string{"__oailb=node-123.456; path=/; HttpOnly", "refresh_token=secret_rt_456; path=/; HttpOnly", "__cf_bm=lb123; path=/; HttpOnly"},
+		"X-Private-Note":   []string{"unclassified-header"},
+	}
+	CodexDumpHTTPRequest("session", "upstream_out", "POST", "https://user:pass@api.example/v1/responses?token=query-secret", headers, body)
+	CodexDumpHTTPResponse("session", "upstream_in", 200, headers, body)
+
+	view := output.String()
+	for _, secret := range []string{"body-secret", "private prompt text", "header-secret", "query-secret", "user:pass", "secret_at_123", "secret_rt_456"} {
+		if strings.Contains(view, secret) {
+			t.Fatalf("HTTP trace view exposed %q: %s", secret, view)
