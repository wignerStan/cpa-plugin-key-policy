+func TestCodexTraceCookiePolicyMatchesMetadataAndHeaders(t *testing.T) {
+	output := captureCodexDumpLogs(t)
+	log.SetLevel(log.TraceLevel)
+	route := "eyJhbGciOiJIUzI1NiJ9.eyJyb3V0ZSI6Indlc3QifQ.sig"
+	cookie := "__oailb=" + route + "; session=visible-session; sid=visible-sid; at=secret-access; rt=secret-refresh"
+	headers := http.Header{"Cookie": []string{cookie}, "Authorization": []string{"Bearer secret-auth"}}
+	CodexDumpHTTPRequest("cookie-policy", "client_in", "POST", "https://example.test/responses", headers, nil)
+	CodexDumpFrame("cookie-policy", "upstream_in", []byte(`{"type":"response.metadata","headers":{"cookie":"`+cookie+`"}}`))
+	view := output.String()
+	for _, plain := range []string{route, "visible-session", "visible-sid"} {
+		if strings.Count(view, plain) != 2 {
+			t.Fatalf("metadata/header policy differ for %s: %s", plain, view)
+		}
+	}
+	for _, secret := range []string{"secret-access", "secret-refresh", "secret-auth"} {
+		if strings.Contains(view, secret) {
+			t.Fatalf("credential exposed: %s", secret)
+		}
+	}
+}
