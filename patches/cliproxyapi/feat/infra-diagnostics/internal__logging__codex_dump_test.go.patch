+	}
+	for _, public := range []string{"application/json", "a%252Fb", "opaque-public", "api.example", "8e12345-SJC", "__cf_bm=lb123", "__oailb=node-123.456", "session=user_secret", "access_token=sha256:", "refresh_token=sha256:"} {
+		if !strings.Contains(view, public) {
+			t.Fatalf("HTTP trace view omitted public or classified view value %q: %s", public, view)
+		}
+	}
+}
