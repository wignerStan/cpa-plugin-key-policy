+func TestCodexDumpSummarySelectionExcludesPromptsAnswersAndDeltas(t *testing.T) {
+	output := captureCodexDumpLogs(t)
+	log.SetLevel(log.TraceLevel)
+	ConfigureCodexDump(false, "")
+	CodexDumpHTTPRequest("session", "client_in", "POST", "https://example.test/responses", nil, []byte(`{"type":"response.reasoning_summary_text.done","text":"private-prompt","summary":"private-summary","input":[{"text":"private-input"}]}`))
+	CodexDumpFrame("session", "client_in", []byte(`{"type":"response.reasoning_summary_text.done","text":"private-ws-input"}`))
+	CodexDumpHTTPResponse("session", "unknown", 200, nil, []byte(`{"type":"response.reasoning_summary_text.done","text":"private-unknown-leg"}`))
+	CodexDumpFrame("session", "upstream_in", []byte(`{"type":"response.output_item.done","item":{"type":"message","content":[{"text":"private-answer"}]}}`))
+	before := output.Len()
+	CodexDumpFrame("session", "upstream_in", []byte(`{"type":"response.reasoning_summary_text.delta","delta":"private-delta"}`))
+	if output.Len() != before {
+		t.Fatal("delta generated TRACE")
+	}
+	for _, secret := range []string{"private-prompt", "private-summary", "private-input", "private-ws-input", "private-unknown-leg", "private-answer", "private-delta"} {
+		if strings.Contains(output.String(), secret) {
+			t.Fatalf("unselected text leaked %s", secret)
+		}
+	}
+	fields := log.Fields{}
+	addPayloadView(fields, []byte(`{"type":"response.reasoning_summary_text.done","text":"`+strings.Repeat("x", maxCodexDumpViewBytes)+`"}`), true)
+	if fields["payload_view_omitted"] != "input-size-limit" {
+		t.Fatal("large summary view not bounded")
+	}
+}
