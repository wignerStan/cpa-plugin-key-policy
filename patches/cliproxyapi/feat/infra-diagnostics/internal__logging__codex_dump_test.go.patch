+func TestCodexDumpTraceViewRedactsSecretsAndPreservesRawOnlyWhenAuthorized(t *testing.T) {
+	output := captureCodexDumpLogs(t)
+	log.SetLevel(log.TraceLevel)
+	logDir := t.TempDir()
+	payload := []byte(`{"type":"response.create","api_key":"fixture-secret","scheme":"Bearer","routing_token":"opaque-public","prompt":"private prompt text"}`)
+
+	ConfigureCodexDump(false, logDir)
+	CodexDumpFrame("session", "client_in", payload)
+	view := output.String()
+	for _, secret := range []string{"fixture-secret", "private prompt text"} {
+		if strings.Contains(view, secret) {
+			t.Fatalf("trace view exposed classified or unclassified payload data %q: %s", secret, view)
+		}
+	}
+	if !strings.Contains(view, "response.create") || !strings.Contains(view, "sha256:") {
+		t.Fatalf("trace view omitted event or sha256: %s", view)
+	}
+	if !strings.Contains(view, "opaque-public") || !strings.Contains(view, "Bearer") {
+		t.Fatalf("trace view changed public fields: %s", view)
+	}
+	if _, err := os.Stat(filepath.Join(logDir, "codex-dumps")); !os.IsNotExist(err) {
+		t.Fatalf("TRACE alone created a raw capture directory, stat error = %v", err)
+	}
+
+	if runtime.GOOS != "linux" {
+		t.Skip("raw capture artifacts are supported on Linux only")
+	}
+	output.Reset()
+	ConfigureCodexDump(true, logDir)
+	CodexDumpFrame("session", "client_in", payload)
+	view = output.String()
+	if strings.Contains(view, "fixture-secret") {
+		t.Fatalf("captured payload leaked into trace view: %s", view)
+	}
+	if !strings.Contains(view, `"capture_queued":true`) {
+		t.Fatalf("capture receipt missing from trace view: %s", view)
+	}
+	FlushAllStreamBuffers()
+	files, err := os.ReadDir(filepath.Join(logDir, "codex-dumps"))
+	if err != nil {
+		t.Fatalf("read capture directory: %v", err)
+	}
+	if len(files) != 1 {
+		t.Fatalf("capture files = %d, want 1", len(files))
+	}
+	path := filepath.Join(logDir, "codex-dumps", files[0].Name())
+	got, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read capture artifact: %v", err)
+	}
+	if !bytes.Equal(got, payload) {
+		t.Fatalf("raw capture changed bytes: got %q, want %q", got, payload)
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatalf("stat capture artifact: %v", err)
+	}
+	if info.Mode().Perm() != 0o600 {
+		t.Fatalf("capture file mode = %o, want 600", info.Mode().Perm())
+	}
+	dirInfo, err := os.Stat(filepath.Dir(path))
+	if err != nil {
+		t.Fatalf("stat capture directory: %v", err)
+	}
+	if dirInfo.Mode().Perm() != 0o700 {
+		t.Fatalf("capture directory mode = %o, want 700", dirInfo.Mode().Perm())
+	}
+}
