+func TestCodexDumpStreamingBufferPreservesDeltas(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("raw capture artifacts are supported on Linux only")
+	}
+
+	logDir := t.TempDir()
+	ConfigureCodexDump(true, logDir)
+	t.Cleanup(func() { ConfigureCodexDump(false, "") })
+
+	delta1 := []byte(`{"type":"response.custom_tool_call_input.delta","delta":"hello"}`)
+	delta2 := []byte(`{"type":"response.custom_tool_call_input.delta","delta":" world"}`)
+	completed := []byte(`{"type":"response.completed","status":"completed"}`)
+
+	CodexDumpFrame("stream-session-1", "client_out", delta1)
+	CodexDumpFrame("stream-session-1", "client_out", delta2)
+	CodexDumpFrame("stream-session-1", "client_out", completed)
+
+	FlushAllStreamBuffers()
+
+	FlushAllStreamBuffers()
+	files, err := os.ReadDir(filepath.Join(logDir, "codex-dumps"))
+	if err != nil {
+		t.Fatalf("read capture directory: %v", err)
+	}
+	if len(files) != 1 {
+		t.Fatalf("expected 1 unified stream file, got %d", len(files))
+	}
+
+	content, err := os.ReadFile(filepath.Join(logDir, "codex-dumps", files[0].Name()))
+	if err != nil {
+		t.Fatalf("read stream file: %v", err)
+	}
+	contentStr := string(content)
+	if !strings.Contains(contentStr, "hello") || !strings.Contains(contentStr, " world") || !strings.Contains(contentStr, "response.completed") {
+		t.Fatalf("stream buffer missed deltas, got: %s", contentStr)
+	}
+
+	// Test HTTP chunks
+	chunk1 := []byte("data: {\"type\":\"chunk1\"}\n\n")
+	chunkDone := []byte("data: [DONE]\n\n")
+
+	CodexDumpHTTPChunk("stream-http-1", "upstream_in", chunk1)
+	CodexDumpHTTPChunk("stream-http-1", "upstream_in", chunkDone)
+	CodexDumpHTTPFinish("stream-http-1", "upstream_in")
+
+	FlushAllStreamBuffers()
+
+	files2, err := os.ReadDir(filepath.Join(logDir, "codex-dumps"))
+	if err != nil {
+		t.Fatalf("read capture directory: %v", err)
+	}
+	if len(files2) != 2 {
+		t.Fatalf("expected 2 files total (1 ws stream + 1 http stream), got %d", len(files2))
+	}
+}
