+func captureCodexDumpLogs(t *testing.T) *bytes.Buffer {
+	t.Helper()
+	logger := log.StandardLogger()
+	originalOutput := logger.Out
+	originalFormatter := logger.Formatter
+	originalLevel := logger.GetLevel()
+	var output bytes.Buffer
+	logger.SetOutput(&output)
+	logger.SetFormatter(&LogFormatter{})
+	t.Cleanup(func() {
+		ConfigureCodexDump(false, "")
+		logger.SetOutput(originalOutput)
+		logger.SetFormatter(originalFormatter)
+		logger.SetLevel(originalLevel)
+	})
+	return &output
+}
+
+func TestCodexDumpDefaultsOff(t *testing.T) {
+	ConfigureCodexDump(false, "")
+	if CodexDumpEnabled() {
+		t.Fatal("CodexDumpEnabled() = true, want false by default")
+	}
+}
+
+func TestCodexDumpDoesNotChangeSelectedLogLevel(t *testing.T) {
+	output := captureCodexDumpLogs(t)
+	log.SetLevel(log.DebugLevel)
+	logDir := t.TempDir()
+	ConfigureCodexDump(true, logDir)
+	t.Cleanup(func() { ConfigureCodexDump(false, "") })
+	if log.GetLevel() != log.DebugLevel {
+		t.Fatalf("log level = %v, want DebugLevel", log.GetLevel())
+	}
+	CodexDumpFrame("session", "client_in", []byte(`{"type":"response.create"}`))
+	if output.Len() != 0 {
+		t.Fatalf("debug selection emitted trace diagnostics: %s", output.String())
+	}
+	if runtime.GOOS == "linux" {
+		FlushAllStreamBuffers()
+		files, err := os.ReadDir(filepath.Join(logDir, "codex-dumps"))
+		if err != nil {
+			t.Fatalf("read capture directory: %v", err)
+		}
+		if len(files) != 1 {
+			t.Fatalf("capture files = %d, want 1", len(files))
+		}
+	}
+}
