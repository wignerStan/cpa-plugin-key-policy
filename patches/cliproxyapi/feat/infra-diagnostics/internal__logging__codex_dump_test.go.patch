+func TestCodexDumpProviderReasoningSummariesReadableAtDone(t *testing.T) {
+	for _, payload := range []string{
+		`{"type":"response.reasoning_summary_text.done","text":"I will inspect the route before calling the tool."}`,
+		`{"type":"response.reasoning_summary_part.done","part":{"type":"summary_text","text":"I will inspect the route before calling the tool."}}`,
+		`{"type":"response.reasoning_summary_part.done","part":{"summary_text":"I will inspect the route before calling the tool."}}`,
+		`{"type":"response.output_item.done","item":{"type":"reasoning","summary":[{"type":"summary_text","text":"I will inspect the route before calling the tool."}],"encrypted_content":"hidden-encrypted"}}`,
+		`{"type":"response.completed","response":{"usage":{"total_tokens":7},"output":[{"type":"reasoning","summary":[{"type":"summary_text","text":"I will inspect the route before calling the tool.","content":"hidden-answer","encrypted_content":"hidden-encrypted"}],"encrypted_content":"hidden-encrypted"},{"type":"message","content":[{"type":"output_text","text":"hidden-answer"}]}]}}`,
+	} {
+		t.Run(gjson.Get(payload, "type").String(), func(t *testing.T) {
+			output := captureCodexDumpLogs(t)
+			log.SetLevel(log.TraceLevel)
+			ConfigureCodexDump(false, "")
+			raw := []byte(payload)
+			before := bytes.Clone(raw)
+			CodexDumpFrame("plain-session", "upstream_in", raw)
+			view := output.String()
+			if !strings.Contains(view, "I will inspect the route before calling the tool.") {
+				t.Fatalf("summary omitted: %s", view)
+			}
+			for _, hidden := range []string{"hidden-encrypted", "hidden-answer", "sha256:"} {
+				if strings.Contains(view, hidden) {
+					t.Fatalf("unexpected value %s: %s", hidden, view)
+				}
+			}
+			if !bytes.Equal(raw, before) {
+				t.Fatal("trace altered wire payload")
+			}
+		})
+	}
+}
