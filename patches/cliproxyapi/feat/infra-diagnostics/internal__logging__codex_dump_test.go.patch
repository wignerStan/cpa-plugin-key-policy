+func TestCodexDumpReadableMetadataAndExplicitCredentials(t *testing.T) {
+	output := captureCodexDumpLogs(t)
+	log.SetLevel(log.TraceLevel)
+	ConfigureCodexDump(false, "")
+	payload := []byte(`{"type":"codex.response.metadata","headers":{"x-codex-turn-state":"opaque-readable-state","x-models-etag":"catalog"},"metadata":{"token":"public-ambiguous-token","routing_token":"public-route","session_id":"plain-session","decision":"continue","total_tokens":42,"api_key":"private-key","authorization":"Bearer private-auth","jwt":"private-jwt","cookie":"__Secure-session=private-session; cf_clearance=public-lb"}}`)
+	CodexDumpFrame("plain-session", "upstream_in", payload)
+	view := output.String()
+	for _, visible := range []string{"opaque-readable-state", "public-ambiguous-token", "public-route", "plain-session", "continue", "42", "public-lb"} {
+		if !strings.Contains(view, visible) {
+			t.Fatalf("public value missing %s: %s", visible, view)
+		}
+	}
+	for _, secret := range []string{"private-key", "private-auth", "private-jwt", "private-session"} {
+		if strings.Contains(view, secret) {
+			t.Fatalf("credential leaked %s: %s", secret, view)
+		}
+	}
+	if !strings.Contains(view, "sha256:") {
+		t.Fatal("credentials lack fingerprints")
+	}
+}
