+func TestCodexDumpDirectoryGenerationAndDisableDrain(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("Linux raw capture")
+	}
+	first, second := t.TempDir(), t.TempDir()
+	delta := []byte(`{"type":"response.output_text.delta","delta":"first-generation"}`)
+	ConfigureCodexDump(true, first)
+	CodexDumpFrame("same-session", "client_out", delta)
+	ConfigureCodexDump(true, second) // drains old capture before changing directory
+	CodexDumpFrame("same-session", "client_out", []byte(`{"type":"response.completed","generation":"second"}`))
+	ConfigureCodexDump(false, "") // drain and withdraw; late chunks cannot reopen
+	CodexDumpHTTPChunk("same-session", "client_out", []byte("late"))
+	for index, dir := range []string{first, second} {
+		files, err := os.ReadDir(filepath.Join(dir, "codex-dumps"))
+		if err != nil || len(files) != 1 {
+			t.Fatalf("generation %d: %v / %v", index, files, err)
+		}
+		payload, err := os.ReadFile(filepath.Join(dir, "codex-dumps", files[0].Name()))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if index == 0 && !bytes.Equal(payload, append(delta, '\n')) {
+			t.Fatalf("old generation changed: %q", payload)
+		}
+		if index == 1 && (bytes.Contains(payload, []byte("first-generation")) || bytes.Contains(payload, []byte("late"))) {
+			t.Fatalf("generations mixed: %q", payload)
+		}
+	}
+}
