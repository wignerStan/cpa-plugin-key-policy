+func TestCodexDumpArtifactStoresExactBytesPrivately(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("Linux raw capture")
+	}
+	logDir := t.TempDir()
+	ConfigureCodexDump(true, logDir)
+	t.Cleanup(func() { ConfigureCodexDump(false, "") })
+	t.Cleanup(func() { ConfigureCodexDump(false, "") })
+	payload := []byte{0x00, 0x01, 0x7f, 0x80, 0xff}
+	CodexDumpBinaryFrame("session", "client_in", payload)
+	FlushAllStreamBuffers()
+	files, err := os.ReadDir(filepath.Join(logDir, "codex-dumps"))
+	if err != nil || len(files) != 1 {
+		t.Fatalf("artifacts: %v / %v", files, err)
+	}
+	path := filepath.Join(logDir, "codex-dumps", files[0].Name())
+	got, err := os.ReadFile(path)
+	if err != nil || !bytes.Equal(got, payload) {
+		t.Fatalf("exact bytes: %v / %v", got, err)
+	}
+	info, err := os.Stat(path)
+	if err != nil || info.Mode().Perm() != 0600 {
+		t.Fatalf("file permissions: %v / %v", info, err)
+	}
+	dirInfo, err := os.Stat(filepath.Dir(path))
+	if err != nil || dirInfo.Mode().Perm() != 0700 {
+		t.Fatalf("directory permissions: %v / %v", dirInfo, err)
+	}
+}
