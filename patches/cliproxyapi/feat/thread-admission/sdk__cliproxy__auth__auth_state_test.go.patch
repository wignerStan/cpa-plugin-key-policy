+package auth
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	core "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+type admissionStore struct {
+	fail  bool
+	saved *Auth
+}
+
+func (s *admissionStore) List(context.Context) ([]*Auth, error) { return nil, nil }
+func (s *admissionStore) Delete(context.Context, string) error  { return nil }
+func (s *admissionStore) Save(_ context.Context, a *Auth) (string, error) {
+	if s.fail {
+		return "", errors.New("disk unavailable")
+	}
+	s.saved = a.Clone()
+	return a.ID, nil
+}
+
+func TestAuthAdmissionVersionIgnoresRequestsAndTokenRefresh(t *testing.T) {
+	m, ids := threadManager(t, &FillFirstSelector{})
+	initial, _ := m.GetByID(ids[0])
+	initial.Metadata = map[string]any{"access_token": "initial-token"}
+	if _, err := m.Update(context.Background(), initial); err != nil {
+		t.Fatal(err)
+	}
+	before, err := m.AuthState(ids[0], "model")
+	if err != nil {
+		t.Fatal(err)
+	}
+	m.MarkResult(context.Background(), Result{AuthID: ids[0], Provider: "codex", Model: "model", Success: true})
+	a, _ := m.GetByID(ids[0])
+	a.Metadata = map[string]any{"access_token": "new-token"}
+	if _, err = m.Update(context.Background(), a); err != nil {
+		t.Fatal(err)
+	}
+	after, err := m.AuthState(ids[0], "model")
+	if err != nil || after.Version != before.Version {
+		t.Fatal("ordinary traffic changed inspection version", after, err)
+	}
+	setThreadProviderState(t, m, ids[0], "disable-provider")
+	setThreadProviderState(t, m, ids[0], "enable-provider")
+	after, err = m.AuthState(ids[0], "model")
+	if err != nil || after.Version == before.Version || after.Disabled {
+		t.Fatal("re-enable reused old verdict", after, err)
+	}
+}
+
+func TestAuthDisableCannotPublishAfterPersistenceFailure(t *testing.T) {
+	m, ids := threadManager(t, &FillFirstSelector{})
+	store := &admissionStore{fail: true}
+	m.SetStore(store)
+	before, _ := m.AuthState(ids[0], "model")
+	disabled := true
+	req := pluginapi.HostAuthStateRequest{AuthID: ids[0], Model: "model", Version: before.Version, Disabled: &disabled}
+	if _, err := m.SetAuthDisabled(context.Background(), req, nil); err == nil {
+		t.Fatal("failed persistence acknowledged")
+	}
+	after, _ := m.AuthState(ids[0], "model")
+	if after.Disabled || after.Version != before.Version {
+		t.Fatal("memory changed before durable disable")
+	}
+	store.fail = false
+	after, err := m.SetAuthDisabled(context.Background(), req, nil)
+	if err != nil || !after.Disabled || store.saved == nil || !store.saved.Disabled {
+		t.Fatal("native disable not persisted", after, err)
+	}
+	current, _ := m.GetByID(ids[0])
+	if store.saved.Generation != current.Generation || store.saved.AdmissionVersion != current.AdmissionVersion {
+		t.Fatal("persisted version differs from committed version")
+	}
+}
+
+func TestSingleExecutionRetainsTransportErrorWithoutRetry(t *testing.T) {
+	for _, upstream := range []bool{false, true} {
+		m, ids := threadManager(t, &FillFirstSelector{})
+		calls := 0
+		m.SetRetryConfig(3, 0, 0)
+		m.RegisterExecutor(&mockCustomErrorExecutor{identifier: "codex", executeFn: func(ctx context.Context, _ *Auth, _ core.Request, _ core.Options) (core.Response, error) {
+			calls++
+			if upstream {
+				core.MarkUpstreamAttempt(ctx)
+			}
+			return core.Response{}, &Error{HTTPStatus: 503, Message: "failure"}
+		}})
+		opts := threadOptions("inspection")
+		opts.Metadata[core.PinnedAuthMetadataKey] = ids[0]
+		_, err := m.Execute(WithSingleExecutionAttempt(context.Background()), []string{"codex"}, core.Request{Model: "model"}, opts)
+		if err == nil || calls != 1 || HasUpstreamAttempt(err) != upstream {
+			t.Fatalf("calls=%d upstream=%v error=%v", calls, upstream, err)
+		}
+	}
+}
