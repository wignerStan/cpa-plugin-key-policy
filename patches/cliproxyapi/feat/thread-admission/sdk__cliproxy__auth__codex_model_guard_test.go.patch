+func TestModelGuardRequestIDSurvivesNativeTargetReselection(t *testing.T) {
+	for _, stream := range []bool{false, true} {
+		t.Run(map[bool]string{false: "response", true: "stream"}[stream], func(t *testing.T) {
+			m, ids := threadManager(t, &FillFirstSelector{})
+			opts := guardOptions()
+			delete(opts.Metadata, "model_guard_request_id")
+			var requestIDs, targets []string
+			host := guardHostFunc(func(ctx context.Context, _ string, in pluginapi.ModelGuardExchange) (pluginapi.ModelGuardDecision, error) {
+				requestIDs, targets = append(requestIDs, in.RequestID), append(targets, in.Route.AuthID)
+				if in.Route.AuthID == ids[0] {
+					disableThread(t, m, ids[0], opts)
+					return pluginapi.ModelGuardDecision{Action: "reselect"}, nil
+				}
+				callbacks := pluginapi.ExecutionCallbacksFrom(ctx)
+				req := pluginapi.HostModelExecutionRequest{AuthID: in.Route.AuthID, Model: in.Scope.Model, Body: in.Request, Headers: in.Headers, Stream: stream}
+				d := pluginapi.ModelGuardDecision{Action: "release"}
+				if stream {
+					result, err := callbacks.Stream(ctx, req)
+					if err != nil {
+						return d, err
+					}
+					d.Receipt = result.Response.Receipt
+					for chunk := range result.Chunks {
+						if chunk.Err != nil {
+							return d, chunk.Err
+						}
+						d.Chunks = append(d.Chunks, chunk.Payload)
+					}
+				} else {
+					result, err := callbacks.Execute(ctx, req)
+					if err != nil {
+						return d, err
+					}
+					d.Receipt, d.Response.Body = result.Receipt, result.Body
+				}
+				return d, nil
+			})
+			if err := m.ConfigureCodexModelGuard(host, "guard", []string{""}); err != nil {
+				t.Fatal(err)
+			}
+			for n := 0; n < 2; n++ {
+				if stream {
+					result, err := m.ExecuteStream(context.Background(), []string{"codex"}, guardRequest(), opts)
+					if err != nil {
+						t.Fatal(err)
+					}
+					for chunk := range result.Chunks {
+						if chunk.Err != nil {
+							t.Fatal(chunk.Err)
+						}
+					}
+				} else if _, err := m.Execute(context.Background(), []string{"codex"}, guardRequest(), opts); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if len(requestIDs) != 3 || requestIDs[0] == "" || requestIDs[0] != requestIDs[1] || requestIDs[1] == requestIDs[2] || targets[0] != ids[0] || targets[1] != ids[1] {
+				t.Fatal("request identity reset across native selection", requestIDs, targets)
+			}
+			if _, exists := opts.Metadata["model_guard_request_id"]; exists {
+				t.Fatal("Manager mutated caller options")
+			}
+		})
+	}
+}
