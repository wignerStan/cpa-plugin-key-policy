+func TestModelGuardInvalidTargetFailsStartup(t *testing.T) {
+	for name, target := range map[string]internalconfig.CodexModelGuardTarget{
+		"empty": {}, "wildcard-id": {AuthIDs: []string{"key-*"}}, "empty-id": {AuthIDs: []string{""}},
+		"whitespace": {Models: []string{" model"}}, "wildcard-model": {Models: []string{"lab/*"}},
+		"partial-url": {BaseURLs: []string{"example.com"}}, "credentials": {BaseURLs: []string{"https://user:pass@example.com/v1"}},
+		"query": {BaseURLs: []string{"https://example.com/v1?key=x"}}, "fragment": {BaseURLs: []string{"https://example.com/v1#foo"}},
+		"wildcard-host": {BaseURLs: []string{"https://*.example.com/v1"}},
+	} {
+		t.Run(name, func(t *testing.T) {
+			m, _ := threadManager(t, &FillFirstSelector{})
+			host := guardHostFunc(func(context.Context, string, pluginapi.ModelGuardExchange) (pluginapi.ModelGuardDecision, error) {
+				return pluginapi.ModelGuardDecision{}, nil
+			})
+			if err := m.ConfigureCodexModelGuard(host, "guard", []string{""}, target); err == nil || m.ModelGuardEnabled() {
+				t.Fatal("invalid target enabled guard")
+			}
+		})
+	}
+}
