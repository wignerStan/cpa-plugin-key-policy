+func TestModelGuardUnmatchedCandidatePreventsFallback(t *testing.T) {
+	for _, oauth := range []bool{false, true} {
+		t.Run(map[bool]string{false: "unmatched-api-key", true: "oauth"}[oauth], func(t *testing.T) {
+			m, ids := threadManager(t, &FillFirstSelector{})
+			if oauth {
+				a, _ := m.GetByID(ids[1])
+				a.Attributes["auth_kind"] = "oauth"
+				if _, err := m.Update(context.Background(), a); err != nil {
+					t.Fatal(err)
+				}
+			}
+			host := guardHostFunc(func(context.Context, string, pluginapi.ModelGuardExchange) (pluginapi.ModelGuardDecision, error) {
+				t.Fatal("unmatched ordinary candidate must prevent PAYG")
+				return pluginapi.ModelGuardDecision{}, nil
+			})
+			if err := m.ConfigureCodexModelGuard(host, "guard", []string{""}, internalconfig.CodexModelGuardTarget{AuthIDs: []string{ids[0]}}); err != nil {
+				t.Fatal(err)
+			}
+			opts := guardOptions()
+			for _, id := range ids {
+				disableThread(t, m, id, opts)
+			}
+			d, err := m.ModelGuardRouting(context.Background(), guardRequest(), opts, &modelGuardReselect{})
+			if err != nil || d.Action != "continue" {
+				t.Fatal("false pool exhaustion", d, err)
+			}
+			a, err := m.SelectAuth(context.Background(), "codex", "model", opts)
+			if err != nil || a.ID != ids[1] {
+				t.Fatal("ordinary candidate did not survive lease filter", err)
+			}
+		})
+	}
+}
+func TestModelGuardHoldsUntilPluginReturnsAndRechecksDisable(t *testing.T) {
+	m, ids := threadManager(t, &FillFirstSelector{})
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	host := guardHostFunc(func(ctx context.Context, _ string, in pluginapi.ModelGuardExchange) (pluginapi.ModelGuardDecision, error) {
+		callbacks := pluginapi.ExecutionCallbacksFrom(ctx)
+		r, e := callbacks.Execute(ctx, pluginapi.HostModelExecutionRequest{Model: in.Scope.Model, AuthID: in.Route.AuthID, Body: in.Request, Headers: in.Headers})
+		if e != nil {
+			return pluginapi.ModelGuardDecision{}, e
+		}
+		if e = callbacks.Validate(ctx, r.Receipt); e != nil {
+			return pluginapi.ModelGuardDecision{}, e
+		}
+		close(entered)
+		<-release
+		return pluginapi.ModelGuardDecision{Action: "release", Receipt: r.Receipt, Response: pluginapi.ModelGuardObservation{Body: r.Body, Headers: r.Headers}}, nil
+	})
+	if e := m.ConfigureCodexModelGuard(host, "guard", []string{""}); e != nil {
+		t.Fatal(e)
+	}
+	done := make(chan error, 1)
+	go func() {
+		a, _ := m.GetByID(ids[0])
+		r, e := m.executeWithModelGuard(context.Background(), m.executorFor("codex"), a, guardRequest(), guardOptions(), "model")
+		if len(r.Payload) > 0 {
+			done <- errors.New("disabled held output released")
+			return
+		}
+		done <- e
+	}()
+	<-entered
+	select {
+	case <-done:
+		t.Fatal("output crossed hold before decision")
+	default:
+	}
+	disableThread(t, m, ids[0], guardOptions())
+	close(release)
+	if e := <-done; e == nil {
+		t.Fatal("release did not recheck disk")
+	}
+}
+func TestModelGuardCannotForgeReceiptOrReselect(t *testing.T) {
+	for _, action := range []string{"release", "reselect"} {
+		t.Run(action, func(t *testing.T) {
+			m, ids := threadManager(t, &FillFirstSelector{})
+			host := guardHostFunc(func(context.Context, string, pluginapi.ModelGuardExchange) (pluginapi.ModelGuardDecision, error) {
+				return pluginapi.ModelGuardDecision{Action: action, Receipt: "forged", Response: pluginapi.ModelGuardObservation{Body: []byte("leak")}}, nil
+			})
+			m.ConfigureCodexModelGuard(host, "guard", []string{""})
+			a, _ := m.GetByID(ids[0])
+			if r, e := m.executeWithModelGuard(context.Background(), m.executorFor("codex"), a, guardRequest(), guardOptions(), "model"); e == nil || len(r.Payload) > 0 {
+				t.Fatal("forged gate action admitted", e)
+			}
+		})
+	}
+}
+func TestGuardRotationClearsInternalSessionMetadata(t *testing.T) {
+	in := map[string]any{core.CallerScopeMetadataKey: "caller", core.CanonicalSessionIDMetadataKey: "old", core.LCPAffinitySessionIDMetadataKey: "old", core.ParentSessionIDMetadataKey: "old", core.IsForkMetadataKey: true, "lcp_fingerprints": "old", core.SessionAffinityModelMetadataKey: "old"}
+	out := guardSessionMetadata(in, "new")
+	if out[core.CallerScopeMetadataKey] != "caller" || out[core.CanonicalSessionIDMetadataKey] != "execution:new" {
+		t.Fatal("scope lost")
+	}
+	for _, k := range []string{core.LCPAffinitySessionIDMetadataKey, core.ParentSessionIDMetadataKey, core.IsForkMetadataKey, "lcp_fingerprints", core.SessionAffinityModelMetadataKey} {
+		if _, ok := out[k]; ok {
+			t.Fatal("old affinity retained", k)
+		}
+	}
+	if in[core.CanonicalSessionIDMetadataKey] != "old" {
+		t.Fatal("original metadata mutated")
+	}
+}
