+func TestModelGuardUnmatchedBypassesExecutionAndThreadLease(t *testing.T) {
+	for _, mode := range []string{"oauth", "unknown", "unmatched-api-key", "unmatched-model", "default-oauth"} {
+		t.Run(mode, func(t *testing.T) {
+			m, ids := threadManager(t, &FillFirstSelector{})
+			a, _ := m.GetByID(ids[0])
+			if mode == "oauth" || mode == "default-oauth" {
+				a.Attributes["auth_kind"] = "oauth"
+				a.Attributes["api_key"] = "legacy-present"
+			}
+			if mode == "unknown" {
+				delete(a.Attributes, "auth_kind")
+			}
+			if _, err := m.Update(context.Background(), a); err != nil {
+				t.Fatal(err)
+			}
+			calls := 0
+			host := guardHostFunc(func(context.Context, string, pluginapi.ModelGuardExchange) (pluginapi.ModelGuardDecision, error) {
+				calls++
+				return pluginapi.ModelGuardDecision{}, errors.New("guard intentionally unavailable")
+			})
+			target := internalconfig.CodexModelGuardTarget{AuthIDs: []string{ids[0]}}
+			if mode == "unmatched-api-key" {
+				target.AuthIDs = []string{ids[1]}
+			}
+			if mode == "unmatched-model" {
+				target.Models = []string{"other"}
+			}
+			targets := []internalconfig.CodexModelGuardTarget{target}
+			if mode == "default-oauth" {
+				targets = nil
+			}
+			if err := m.ConfigureCodexModelGuard(host, "guard", []string{""}, targets...); err != nil {
+				t.Fatal(err)
+			}
+			opts := guardOptions()
+			disableThread(t, m, ids[0], opts)
+			// A stale disk exclusion and even invalid guard-only metadata must not
+			// affect credentials or models outside this guard's scope.
+			opts.Headers.Set("X-Codex-Turn-Metadata", "not-json")
+			allowed, err := m.filterCodexThreadCandidates(context.Background(), "model", opts, []*Auth{a})
+			if err != nil || len(allowed) != 1 || allowed[0].ID != a.ID {
+				t.Fatal("unmatched filtered", err)
+			}
+			if err := m.beginCodexThreadDispatch(context.Background(), a, "model", &opts); err != nil {
+				t.Fatal(err)
+			}
+			r, err := m.executeWithModelGuard(context.Background(), m.executorFor("codex"), a, guardRequest(), opts, "model")
+			if err != nil || string(r.Payload) != a.ID {
+				t.Fatal("unmatched non-stream blocked", err)
+			}
+			s, err := m.streamWithModelGuard(context.Background(), m.executorFor("codex"), a, guardRequest(), opts, "model")
+			if err != nil {
+				t.Fatal("unmatched stream blocked", err)
+			}
+			var output string
+			for chunk := range s.Chunks {
+				if chunk.Err != nil {
+					t.Fatal(chunk.Err)
+				}
+				output += string(chunk.Payload)
+			}
+			if output != a.ID || calls != 0 {
+				t.Fatal("unmatched execution called guard", calls)
+			}
+		})
+	}
+}
