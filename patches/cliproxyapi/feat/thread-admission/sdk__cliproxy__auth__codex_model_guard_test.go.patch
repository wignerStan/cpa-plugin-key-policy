+type guardHostFunc func(context.Context, string, pluginapi.ModelGuardExchange) (pluginapi.ModelGuardDecision, error)
+
+func (f guardHostFunc) ExchangeModelGuard(ctx context.Context, id string, in pluginapi.ModelGuardExchange) (pluginapi.ModelGuardDecision, error) {
+	return f(ctx, id, in)
+}
+func guardOptions() core.Options {
+	o := threadOptions("logical-thread")
+	o.Metadata["model_guard_request_id"] = "request"
+	o.SourceFormat = translator.FormatOpenAIResponse
+	o.Headers.Set("X-Codex-Turn-Metadata", `{"thread_id":"logical-thread","turn_id":"turn"}`)
+	return o
+}
+func guardRequest() core.Request {
+	return core.Request{Model: "model", Payload: []byte(`{"model":"model","input":"private input"}`)}
+}
