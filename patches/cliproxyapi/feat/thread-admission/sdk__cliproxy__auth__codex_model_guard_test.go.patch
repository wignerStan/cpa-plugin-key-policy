+func TestModelGuardExactTargetsAndCredentialKinds(t *testing.T) {
+	m, _ := threadManager(t, &FillFirstSelector{})
+	targets := []internalconfig.CodexModelGuardTarget{
+		{AuthIDs: []string{"key-a", "key-b"}, BaseURLs: []string{"https://UPSTREAM.example/v1/"}, Models: []string{"lab/model", "lab/other"}},
+		{AuthIDs: []string{"key-c"}, BaseURLs: []string{"https://second.example/v1"}, Models: []string{"lab/model"}},
+	}
+	host := guardHostFunc(func(context.Context, string, pluginapi.ModelGuardExchange) (pluginapi.ModelGuardDecision, error) {
+		t.Fatal("matching alone must not call plugin")
+		return pluginapi.ModelGuardDecision{}, nil
+	})
+	if err := m.ConfigureCodexModelGuard(host, "guard", []string{"lab"}, targets...); err != nil {
+		t.Fatal(err)
+	}
+	// Startup configuration must not retain caller-owned slices.
+	targets[0].AuthIDs[0], targets[0].BaseURLs[0], targets[0].Models[0] = "changed", "https://changed.example", "changed"
+	for _, tc := range []struct {
+		name, id, provider, kind, base, route string
+		want                                  bool
+	}{
+		{"first", "key-a", "codex", "apikey", "https://upstream.example/v1", "lab/model", true},
+		{"second-value", "key-b", "codex", "apikey", "https://upstream.example/v1/", "lab/other", true},
+		{"second-rule", "key-c", "codex", "apikey", "https://second.example/v1", "lab/model", true},
+		{"wrong-id", "key-a-extra", "codex", "apikey", "https://upstream.example/v1", "lab/model", false},
+		{"wrong-base", "key-a", "codex", "apikey", "https://upstream.example/v1/extra", "lab/model", false},
+		{"wrong-host", "key-a", "codex", "apikey", "https://upstream.example.attacker/v1", "lab/model", false},
+		{"wrong-model", "key-a", "codex", "apikey", "https://upstream.example/v1", "lab/model-more", false},
+		{"wrong-prefix", "key-a", "codex", "apikey", "https://upstream.example/v1", "other/model", false},
+		{"cross-rule", "key-c", "codex", "apikey", "https://upstream.example/v1", "lab/model", false},
+		{"oauth", "key-a", "codex", "oauth", "https://upstream.example/v1", "lab/model", false},
+		{"unknown", "key-a", "codex", "", "https://upstream.example/v1", "lab/model", false},
+		{"other-protocol", "key-a", "openai", "apikey", "https://upstream.example/v1", "lab/model", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			a := &Auth{ID: tc.id, Provider: tc.provider, Attributes: map[string]string{"auth_kind": tc.kind, "base_url": tc.base}}
+			if tc.kind == "oauth" {
+				a.Attributes["api_key"] = "legacy-present"
+			}
+			if got := m.guardedAuth(a, tc.route); got != tc.want {
+				t.Fatalf("guarded=%v want=%v", got, tc.want)
+			}
+		})
+	}
+}
