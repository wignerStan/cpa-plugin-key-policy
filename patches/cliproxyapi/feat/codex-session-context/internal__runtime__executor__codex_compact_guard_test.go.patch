+const compactTestTools = `[{"type":"namespace","name":"functions","tools":[{"type":"custom","name":"exec","description":"Run a harmless command","format":{"type":"text"}},{"type":"function","name":"wait","parameters":{"type":"object","properties":{}}}]}]`
+
+func compactTestRequest(generating bool) (core.Request, core.Options) {
+	boundary := `{"type":"compaction","id":"cmp_installed","encrypted_content":"old-compact"}`
+	if generating {
+		boundary = `{"type":"compaction_trigger"}`
+	}
+	body := []byte(`{"model":"gpt-5.6-sol","reasoning":{"effort":"high"},"input":[{"type":"additional_tools","id":"at_original","tools":` + compactTestTools + `},{"type":"message","role":"developer","content":"Original instructions"},{"type":"message","role":"user","content":"Original task"},` + boundary + `],"client_metadata":{"request_kind":"compaction"},"prompt_cache_key":"physical-session"}`)
+	headers := http.Header{"Session-Id": {"physical-session"}, "Thread-Id": {"logical-thread"}, "X-Codex-Turn-State": {"parent-state"}, "X-Openai-Subagent": {"compact"}}
+	headers.Set(codexResponsesLiteHeader, "true")
+	headers.Set("X-Codex-Turn-Metadata", `{"thread_id":"logical-thread","turn_id":"turn","request_kind":"compaction"}`)
+	return core.Request{Model: "gpt-5.6-sol", Payload: body}, core.Options{SourceFormat: translator.FormatOpenAIResponse, Headers: headers, Stream: true}
+}
+
+func compactTestCompletion(w http.ResponseWriter, id, tools, output string) {
+	w.Header().Set("Content-Type", "text/event-stream")
+	fmt.Fprintf(w, "data: {\"type\":\"response.created\",\"response\":{\"id\":%q}}\n\n", id)
+	for _, item := range gjson.Parse(output).Array() {
+		fmt.Fprintf(w, "data: {\"type\":\"response.output_item.done\",\"item\":%s}\n\n", item.Raw)
+	}
+	fmt.Fprintf(w, "data: {\"type\":\"response.completed\",\"response\":{\"id\":%q,\"status\":\"completed\",\"tools\":%s,\"output\":%s,\"usage\":{\"input_tokens\":20000,\"input_tokens_details\":{\"cached_tokens\":19968},\"output_tokens\":1}}}\n\n", id, tools, output)
+}
