+func TestCompactGuardCancelWhileHeld(t *testing.T) {
+	entered := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		fmt.Fprint(w, "data: {\"type\":\"response.created\"}\n\n")
+		w.(http.Flusher).Flush()
+		close(entered)
+		<-r.Context().Done()
+	}))
+	defer server.Close()
+	ctx, cancel := context.WithCancel(context.Background())
+	req, opts := compactTestRequest(true)
+	done := make(chan error, 1)
+	go func() {
+		_, err := NewCodexExecutor(&config.Config{}).ExecuteStream(ctx, codexTestAuth(server.URL), req, opts)
+		done <- err
+	}()
+	<-entered
+	cancel()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatal(err)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("cancel did not release hold")
+	}
+}
