+func TestCompactGuardOverflowStopsWithoutRetry(t *testing.T) {
+	var mu sync.Mutex
+	calls := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		calls++
+		mu.Unlock()
+		w.Header().Set("Content-Type", "text/event-stream")
+		fmt.Fprint(w, "data: {\"type\":\"response.output_text.delta\",\"delta\":\"")
+		io.CopyN(w, strings.NewReader(strings.Repeat("x", codexCompactHoldLimit+1)), codexCompactHoldLimit+1)
+		fmt.Fprint(w, "\"}\n\n")
+	}))
+	defer server.Close()
+	req, opts := compactTestRequest(true)
+	result, err := NewCodexExecutor(&config.Config{}).ExecuteStream(context.Background(), codexTestAuth(server.URL), req, opts)
+	var checked codexCompactGuardError
+	if result != nil || !errors.As(err, &checked) || checked.reason != "hold byte limit" {
+		t.Fatal("overflow was not a local stop", err)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	if calls != 1 {
+		t.Fatal("local overflow charged more upstream requests", calls)
+	}
+}
