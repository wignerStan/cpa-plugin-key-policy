+func TestCompactGuardRegeneratesOriginalAndHoldsUntilProbe(t *testing.T) {
+	for _, nonstream := range []bool{false, true} {
+		t.Run(fmt.Sprint("nonstream=", nonstream), func(t *testing.T) {
+			var mu sync.Mutex
+			var originals [][]byte
+			var originalSockets, probeSockets []string
+			calls := 0
+			probeEntered, releaseProbe := make(chan struct{}), make(chan struct{})
+			server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				body, _ := io.ReadAll(r.Body)
+				mu.Lock()
+				calls++
+				number := calls
+				mu.Unlock()
+				generating, _ := compactBoundary(body)
+				if r.Header.Get("Session-Id") != "physical-session" || gjson.GetBytes(body, "prompt_cache_key").String() != "physical-session" {
+					t.Error("changed physical session")
+				}
+				if gjson.GetBytes(body, "reasoning.effort").String() != "high" {
+					t.Error("changed effort")
+				}
+				if generating {
+					if r.Proto != "HTTP/2.0" {
+						t.Error("parent lost HTTP/2", r.Proto)
+					}
+					mu.Lock()
+					originals = append(originals, body)
+					originalSockets = append(originalSockets, r.RemoteAddr)
+					mu.Unlock()
+					fmt.Fprint(w, "data: {\"type\":\"codex.response.metadata\",\"headers\":{\"x-codex-turn-state\":\"generated-state\"}}\n\n")
+					compactTestCompletion(w, fmt.Sprintf("compact_%d", number), compactTestTools, fmt.Sprintf(`[{"type":"compaction","id":"cmp_%d","encrypted_content":"cipher-%d"}]`, number, number))
+					return
+				}
+				mu.Lock()
+				probeSockets = append(probeSockets, r.RemoteAddr)
+				mu.Unlock()
+				if r.Proto != "HTTP/1.1" || r.Header.Get("X-Codex-Turn-State") != "" || r.Header.Get("X-Openai-Subagent") != "" {
+					t.Error("probe protocol or compact controls", r.Proto)
+				}
+				if strings.Contains(string(body), "compaction_trigger") || strings.Contains(string(body), `"request_kind":"compaction"`) {
+					t.Error("probe retained compact controls")
+				}
+				if number == 2 {
+					compactTestCompletion(w, "probe_bad", `[]`, `[]`)
+					return
+				}
+				close(probeEntered)
+				<-releaseProbe
+				fmt.Fprint(w, "data: {\"type\":\"codex.response.metadata\",\"headers\":{\"x-codex-turn-state\":\"probe-state\"}}\n\n")
+				compactTestCompletion(w, "probe_good", compactTestTools, `[]`)
+			}))
+			server.EnableHTTP2 = true
+			server.StartTLS()
+			defer server.Close()
+			req, opts := compactTestRequest(true)
+			original := bytes.Clone(req.Payload)
+			executor := NewCodexExecutor(&config.Config{})
+			ctx, cancel := context.WithTimeout(context.WithValue(context.Background(), "cliproxy.roundtripper", server.Client().Transport), 10*time.Second)
+			defer cancel()
+			type result struct {
+				body    []byte
+				headers http.Header
+				err     error
+			}
+			done := make(chan result, 1)
+			go func() {
+				if nonstream {
+					opts.Stream = false
+					r, err := executor.Execute(ctx, codexTestAuth(server.URL), req, opts)
+					done <- result{r.Payload, r.Headers, err}
+					return
+				}
+				r, err := executor.ExecuteStream(ctx, codexTestAuth(server.URL), req, opts)
+				if err != nil {
+					done <- result{err: err}
+					return
+				}
+				var buf bytes.Buffer
+				for chunk := range r.Chunks {
+					if chunk.Err != nil {
+						done <- result{err: chunk.Err}
+						return
+					}
+					buf.Write(chunk.Payload)
+				}
+				done <- result{buf.Bytes(), r.Headers, nil}
+			}()
+			select {
+			case <-probeEntered:
+			case r := <-done:
+				t.Fatal("returned before final probe", r.err)
+			case <-ctx.Done():
+				t.Fatal(ctx.Err())
+			}
+			select {
+			case r := <-done:
+				t.Fatal("held response escaped", r.err)
+			default:
+			}
+			close(releaseProbe)
+			r := <-done
+			if r.err != nil {
+				t.Fatal(r.err)
+			}
+			if !bytes.Contains(r.body, []byte("compact_3")) || bytes.Contains(r.body, []byte("compact_1")) || bytes.Contains(r.body, []byte("probe_")) {
+				t.Fatal("released rejected compact or probe", string(r.body))
+			}
+			if r.headers.Get("X-Codex-Turn-State") != "generated-state" {
+				t.Fatal("probe state replaced parent state", r.headers)
+			}
+			mu.Lock()
+			defer mu.Unlock()
+			if len(originals) != 2 || !bytes.Equal(originals[0], originals[1]) || !bytes.Equal(req.Payload, original) {
+				t.Fatal("did not replay original compact body")
+			}
+			if originalSockets[0] != originalSockets[1] {
+				t.Fatal("compact retry dropped reusable parent socket")
+			}
+			for _, socket := range probeSockets {
+				if socket == originalSockets[0] {
+					t.Fatal("probe shared parent socket")
+				}
+			}
+		})
+	}
+}
