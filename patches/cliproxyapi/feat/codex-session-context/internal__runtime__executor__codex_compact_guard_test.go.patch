+func TestCompactGuardExhaustionAndNoOrdinaryReplay(t *testing.T) {
+	for _, generating := range []bool{true, false} {
+		t.Run(fmt.Sprint("generation=", generating), func(t *testing.T) {
+			calls := 0
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				body, _ := io.ReadAll(r.Body)
+				calls++
+				gen, _ := compactBoundary(body)
+				if gen {
+					compactTestCompletion(w, "compact", compactTestTools, `[{"type":"compaction","encrypted_content":"broken"}]`)
+				} else {
+					compactTestCompletion(w, "missing", `[]`, `[]`)
+				}
+			}))
+			defer server.Close()
+			req, opts := compactTestRequest(generating)
+			executor := NewCodexExecutor(&config.Config{Codex: config.CodexConfig{CompactMaxAttempts: 3}})
+			r, err := executor.ExecuteStream(context.Background(), codexTestAuth(server.URL), req, opts)
+			if !generating {
+				if err != nil {
+					t.Fatal("historical compact triggered a new boundary check", err)
+				}
+				for chunk := range r.Chunks {
+					if chunk.Err != nil {
+						t.Fatal(chunk.Err)
+					}
+				}
+				if calls != 1 {
+					t.Fatal("ordinary history was retried", calls)
+				}
+				return
+			}
+			var stopped interface{ IsRequestStop() bool }
+			if r != nil || !errors.As(err, &stopped) || !stopped.IsRequestStop() {
+				t.Fatal("exhaustion exposed bytes or allowed account penalty", err)
+			}
+			want := 1
+			if generating {
+				want = 6
+			}
+			if calls != want {
+				t.Fatalf("requests=%d, want %d", calls, want)
+			}
+		})
+	}
+}
