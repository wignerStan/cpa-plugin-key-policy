+func TestCompactToolCatalogEvidence(t *testing.T) {
+	req, _ := compactTestRequest(true)
+	expected, err := compactRequestTools(req.Payload)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name, tools string
+		pass        bool
+	}{
+		{"complete-without-call", compactTestTools, true},
+		{"empty", `[]`, false},
+		{"server-image-only", `[{"type":"image_generation"}]`, false},
+		{"partial", `[{"type":"namespace","name":"functions","tools":[{"type":"custom","name":"exec"}]}]`, false},
+		{"wrong-namespace", strings.ReplaceAll(compactTestTools, "functions", "other"), false},
+		{"wrong-kind", strings.ReplaceAll(compactTestTools, `"custom"`, `"function"`), false},
+		{"missing-evidence", `null`, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			err := checkCompactTools([]byte(`{"tools":`+tc.tools+`,"output":[],"usage":{"input_tokens_details":{"cached_tokens":19968}}}`), expected)
+			if (err == nil) != tc.pass {
+				t.Fatalf("pass=%t: %v", tc.pass, err)
+			}
+		})
+	}
+	if err := checkCompactTools([]byte(`{}`), nil); err != nil {
+		t.Fatal("no declared tools need no proof", err)
+	}
+}
