+		out.Write(chunk.Payload)
+	}
+	if calls != 2 || !strings.Contains(out.String(), "compact_empty") || strings.Contains(out.String(), "private_") {
+		t.Fatal("private probe leaked or compact was retried", calls, out.String())
+	}
+}
