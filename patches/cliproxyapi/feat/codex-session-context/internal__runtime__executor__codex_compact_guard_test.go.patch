+func TestCompactGuardRetriesClientVisibleOutputDefects(t *testing.T) {
+	for _, defect := range []string{"zero-of-two", "terminal-only", "contradictory-terminal", "after-completed"} {
+		t.Run(defect, func(t *testing.T) {
+			attempts, probes := 0, 0
+			var original []byte
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				body, _ := io.ReadAll(r.Body)
+				generating, _ := compactBoundary(body)
+				if !generating {
+					probes++
+					fmt.Fprintf(w, "data: {\"type\":\"response.created\",\"response\":{\"tools\":%s}}\n\n", compactTestTools)
+					return
+				}
+				attempts++
+				if original == nil {
+					original = bytes.Clone(body)
+				} else if !bytes.Equal(original, body) {
+					t.Error("compact retry changed original body")
+				}
+				if attempts > 1 {
+					compactTestCompletion(w, "accepted", compactTestTools, `[{"type":"reasoning","summary":[]},{"type":"compaction","encrypted_content":"good"}]`)
+					return
+				}
+				compact := `{"type":"compaction","encrypted_content":"terminal-cipher"}`
+				bad := `[{"type":"reasoning","summary":[]},{"type":"message","role":"assistant","content":[]}]`
+				if defect == "zero-of-two" || defect == "contradictory-terminal" {
+					for _, item := range gjson.Parse(bad).Array() {
+						fmt.Fprintf(w, "data: {\"type\":\"response.output_item.done\",\"item\":%s}\n\n", item.Raw)
+					}
+				}
+				terminal := "[" + compact + "]"
+				if defect == "zero-of-two" {
+					terminal = bad
+				}
+				fmt.Fprintf(w, "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"rejected\",\"status\":\"completed\",\"output\":%s}}\n\n", terminal)
+				if defect == "after-completed" {
+					fmt.Fprintf(w, "data: {\"type\":\"response.output_item.done\",\"item\":%s}\n\n", compact)
+				}
+			}))
+			defer server.Close()
+			req, opts := compactTestRequest(true)
+			disabled := false
+			e := NewCodexExecutor(&config.Config{Codex: config.CodexConfig{CompactToolCheck: &disabled, CompactMaxAttempts: 2}})
+			if !e.needsCompactToolGuard(req, opts) {
+				t.Fatal("tool-check opt-out disabled compact shape validation")
+			}
+			result, err := e.ExecuteStream(context.Background(), codexTestAuth(server.URL), req, opts)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var returned bytes.Buffer
+			for chunk := range result.Chunks {
+				if chunk.Err != nil {
+					t.Fatal(chunk.Err)
+				}
+				returned.Write(chunk.Payload)
+			}
+			if attempts != 2 || probes != 0 || bytes.Contains(returned.Bytes(), []byte("rejected")) || !bytes.Contains(returned.Bytes(), []byte("accepted")) {
+				t.Fatal("invalid compact escaped or original was not retried", attempts, probes)
+			}
+		})
+	}
+}
