+func TestCompactGuardUsesEarlyToolCatalogWithoutModelAnswer(t *testing.T) {
+	probeClosed := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		generation, _ := compactBoundary(body)
+		if generation {
+			compactTestCompletion(w, "compact_good", compactTestTools, `[{"type":"compaction","encrypted_content":"good"}]`)
+			return
+		}
+		w.Header().Set("Content-Type", "text/event-stream")
+		fmt.Fprintf(w, "data: {\"type\":\"response.created\",\"response\":{\"id\":\"probe\",\"tools\":%s}}\n\n", compactTestTools)
+		w.(http.Flusher).Flush()
+		<-r.Context().Done()
+		close(probeClosed)
+	}))
+	defer server.Close()
+	req, opts := compactTestRequest(true)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	e := NewCodexExecutor(&config.Config{Codex: config.CodexConfig{StreamBootstrapBuffering: true}})
+	result, err := e.ExecuteStream(ctx, codexTestAuth(server.URL), req, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for chunk := range result.Chunks {
+		if chunk.Err != nil {
+			t.Fatal(chunk.Err)
+		}
+	}
+	select {
+	case <-probeClosed:
+	case <-ctx.Done():
+		t.Fatal("waited for model answer or left probe running")
+	}
+	if !e.cfg.Codex.StreamBootstrapBuffering {
+		t.Fatal("probe mutated parent configuration")
+	}
+}
