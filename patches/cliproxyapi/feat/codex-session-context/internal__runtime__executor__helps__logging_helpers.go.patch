From f753ed9805c096ffa55ee1bb7802985e51b88ba2 Mon Sep 17 00:00:00 2001
From: CPA patch maintainer <cpa-patches@localhost>
Date: Mon, 19 Oct 2026 07:49:04 -0700
Subject: [PATCH] feat(codex): preserve execution session and response metadata
 (internal/runtime/executor/helps/logging_helpers.go)

---
 internal/runtime/executor/helps/logging_helpers.go | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/internal/runtime/executor/helps/logging_helpers.go b/internal/runtime/executor/helps/logging_helpers.go
index e1db2978eef76ab41f773b96ae5449c982976998..c147fd6f065003723d406025ae57a1603079e389 100644
--- a/internal/runtime/executor/helps/logging_helpers.go
+++ b/internal/runtime/executor/helps/logging_helpers.go
@@ -15,6 +15,7 @@ import (
 	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
 	"github.com/router-for-me/CLIProxyAPI/v8/internal/logging"
 	"github.com/router-for-me/CLIProxyAPI/v8/internal/util"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
 	log "github.com/sirupsen/logrus"
 	"github.com/tidwall/gjson"
 )
@@ -63,6 +64,7 @@ func requestLogCaptureEnabled(cfg *config.Config) bool {
 
 // RecordAPIRequest stores the upstream request metadata in Gin context for request logging.
 func RecordAPIRequest(ctx context.Context, cfg *config.Config, info UpstreamRequestLog) {
+	logging.CodexDumpHTTPRequest(cliproxyexecutor.ExecutionSessionID(ctx), "upstream_out", info.Method, info.URL, info.Headers, info.Body)
 	if cfg == nil || cfg.CommercialMode {
 		return
 	}
@@ -190,6 +192,7 @@ func newAPIRequestLogBuilder(index int, info UpstreamRequestLog, timestamp time.
 // RecordAPIResponseMetadata captures upstream response status/header information for the latest attempt.
 func RecordAPIResponseMetadata(ctx context.Context, cfg *config.Config, status int, headers http.Header) {
 	logging.SetResponseHeaders(ctx, headers)
+	logging.CodexDumpHTTPResponse(cliproxyexecutor.ExecutionSessionID(ctx), "upstream_in", status, headers, nil)
 	if !requestLogCaptureEnabled(cfg) {
 		return
 	}
@@ -243,6 +246,7 @@ func RecordAPIResponseError(ctx context.Context, cfg *config.Config, err error)
 
 // AppendAPIResponseChunk appends an upstream response chunk to Gin context for request logging.
 func AppendAPIResponseChunk(ctx context.Context, cfg *config.Config, chunk []byte) {
+	logging.CodexDumpHTTPChunk(cliproxyexecutor.ExecutionSessionID(ctx), "upstream_in", chunk)
 	if !requestLogCaptureEnabled(cfg) {
 		return
 	}
@@ -287,6 +291,9 @@ func AppendAPIResponseChunk(ctx context.Context, cfg *config.Config, chunk []byt
 
 // RecordAPIWebsocketRequest stores an upstream websocket request event in Gin context.
 func RecordAPIWebsocketRequest(ctx context.Context, cfg *config.Config, info UpstreamRequestLog) {
+	if len(info.Body) > 0 {
+		logging.CodexDumpFrame(cliproxyexecutor.ExecutionSessionID(ctx), "upstream_out", info.Body)
+	}
 	if !requestLogCaptureEnabled(cfg) {
 		return
 	}
@@ -320,6 +327,7 @@ func RecordAPIWebsocketRequest(ctx context.Context, cfg *config.Config, info Ups
 // RecordAPIWebsocketHandshake stores the upstream websocket handshake response metadata.
 func RecordAPIWebsocketHandshake(ctx context.Context, cfg *config.Config, status int, headers http.Header) {
 	logging.SetResponseHeaders(ctx, headers)
+	logging.CodexDumpHTTPResponse(cliproxyexecutor.ExecutionSessionID(ctx), "upstream_in", status, headers, nil)
 	if !requestLogCaptureEnabled(cfg) {
 		return
 	}
@@ -378,6 +386,7 @@ func WebsocketUpgradeRequestURL(rawURL string) string {
 
 // AppendAPIWebsocketResponse stores an upstream websocket response frame in Gin context.
 func AppendAPIWebsocketResponse(ctx context.Context, cfg *config.Config, payload []byte) {
+	logging.CodexDumpFrame(cliproxyexecutor.ExecutionSessionID(ctx), "upstream_in", payload)
 	if !requestLogCaptureEnabled(cfg) {
 		return
 	}
