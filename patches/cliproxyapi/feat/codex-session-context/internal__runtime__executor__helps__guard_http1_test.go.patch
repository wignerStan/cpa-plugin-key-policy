Date: Tue, 20 Oct 2026 05:00:00 -0700
Subject: [PATCH] feat(guard): isolate verification HTTP sockets (internal/runtime/executor/helps/guard_http1_test.go)

---
diff --git a/internal/runtime/executor/helps/guard_http1_test.go b/internal/runtime/executor/helps/guard_http1_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..39c9696da4a7c260c7bec499f3a55a957b54a725
--- /dev/null
+++ b/internal/runtime/executor/helps/guard_http1_test.go
@@ -0,0 +1,43 @@
+package helps
+
+import (
+	"context"
+	cryptotls "crypto/tls"
+	"errors"
+	"net"
+	"reflect"
+	"testing"
+	"time"
+)
+
+func TestGuardChromeSideAdvertisesOnlyHTTP1(t *testing.T) {
+	client, server := net.Pipe()
+	defer client.Close()
+	defer server.Close()
+	protocols := make(chan []string, 1)
+	serverDone := make(chan struct{})
+	go func() {
+		defer close(serverDone)
+		conn := cryptotls.Server(server, &cryptotls.Config{GetConfigForClient: func(hello *cryptotls.ClientHelloInfo) (*cryptotls.Config, error) {
+			protocols <- append([]string(nil), hello.SupportedProtos...)
+			return nil, errors.New("test stops after inspecting ClientHello")
+		}})
+		_ = conn.Handshake()
+	}()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	rt := &utlsRoundTripper{http1Only: true, dialer: contextDialerFunc(func(context.Context, string, string) (net.Conn, error) { return client, nil })}
+	_, err := rt.createConnection(ctx, "chatgpt.com", "chatgpt.com:443")
+	if err == nil {
+		t.Fatal("test handshake unexpectedly completed")
+	}
+	select {
+	case actual := <-protocols:
+		if !reflect.DeepEqual(actual, []string{"http/1.1"}) {
+			t.Fatal("side offered another protocol", actual)
+		}
+	case <-ctx.Done():
+		t.Fatal("ClientHello not observed")
+	}
+	<-serverDone
+}
