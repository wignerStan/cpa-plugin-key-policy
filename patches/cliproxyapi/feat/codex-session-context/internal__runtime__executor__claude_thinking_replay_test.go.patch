 .../executor/claude_thinking_replay_test.go   | 22 +++++++++----------
 1 file changed, 11 insertions(+), 11 deletions(-)

diff --git a/internal/runtime/executor/claude_thinking_replay_test.go b/internal/runtime/executor/claude_thinking_replay_test.go
index 553be9c2b2c5b606db98515f055949f88ebc0cb5..7f04adc21f68a53fee7cfac014338399e7120ea2 100644
