+func isCodexThreadTitleSession(headers http.Header) bool {
+	return isCodexThreadTitleMetadata(headers.Get("X-Codex-Turn-Metadata"))
+}
+
+func isCodexThreadTitleRequest(headers http.Header, body []byte) bool {
+	if isCodexThreadTitleSession(headers) {
+		return true
+	}
+	if len(body) == 0 {
+		return false
+	}
+	for _, path := range []string{"client_metadata.thread_source", "metadata.thread_source"} {
+		if strings.EqualFold(strings.TrimSpace(gjson.GetBytes(body, path).String()), "thread_title") {
+			return true
+		}
+	}
+	return false
+}
+
+func isCodexThreadTitleMetadata(raw string) bool {
+	raw = strings.TrimSpace(raw)
+	if raw == "" {
+		return false
+	}
+	return strings.EqualFold(strings.TrimSpace(gjson.Get(raw, "thread_source").String()), "thread_title")
+}
+
+func codexThreadTitleSessionEnabled(h *OpenAIResponsesAPIHandler) bool {
+	if h == nil || h.Cfg == nil || h.Cfg.CodexThreadTitleSession == nil {
+		return true
+	}
+	return *h.Cfg.CodexThreadTitleSession
+}
