+func TestIsCodexThreadTitleSession(t *testing.T) {
+	if isCodexThreadTitleSession(nil) {
+		t.Fatal("nil headers treated as thread_title")
+	}
+	headers := http.Header{}
+	headers.Set("X-Codex-Turn-Metadata", `{"session_id":"s","thread_id":"t","request_kind":"turn","thread_source":"user"}`)
+	if isCodexThreadTitleSession(headers) {
