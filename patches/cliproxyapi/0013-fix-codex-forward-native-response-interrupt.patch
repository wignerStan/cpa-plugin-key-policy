diff --git a/internal/runtime/executor/codex_websockets_interrupt_test.go b/internal/runtime/executor/codex_websockets_interrupt_test.go
new file mode 100644
--- /dev/null
+++ b/internal/runtime/executor/codex_websockets_interrupt_test.go
@@ -0,0 +1,207 @@
+package executor
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/gorilla/websocket"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	core "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+	"github.com/tidwall/gjson"
+)
+
+// The server cannot finish r1 until it receives interrupt. The client cannot
+// submit r2 until it receives the actual upstream incomplete boundary.
+func TestCodexDuplexInterruptLifecycle(t *testing.T) {
+	for _, revoke := range []bool{false, true} {
+		name := "interrupt_and_continue"
+		if revoke {
+			name = "revoked_credential"
+		}
+		t.Run(name, func(t *testing.T) {
+			var connections atomic.Int32
+			var disabled atomic.Bool
+			var wrongAuthID atomic.Bool
+			serverResult := make(chan error, 1)
+			interrupt := []byte(`{ "type": "response.interrupt", "response_id": "r1", "mode": "discard_partial_items" }`)
+			accepted := []byte(`{"type":"response.interrupt.accepted","response_id":"r1","sequence_number":3}`)
+			discarded := []byte(`{"type":"response.output_item.interrupted","response_id":"r1","item_id":"reason-1","output_index":0,"sequence_number":4}`)
+			incomplete := []byte(`{"type":"response.incomplete","sequence_number":5,"response":{"id":"r1","status":"incomplete","incomplete_details":{"reason":"interrupted"},"output":[],"usage":{"input_tokens":10,"output_tokens":2,"total_tokens":12,"input_tokens_details":{"cached_tokens":0},"output_tokens_details":{"reasoning_tokens":2}}}}`)
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				connections.Add(1)
+				serverResult <- func() error {
+					if got := r.Header.Get("Authorization"); got != "Bearer test-key" {
+						return fmt.Errorf("unexpected upstream credential: %q", got)
+					}
+					conn, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+					if err != nil {
+						return err
+					}
+					defer conn.Close()
+					// Failure bounds only; production writes retain their existing behavior.
+					_ = conn.SetReadDeadline(time.Now().Add(5 * time.Second))
+					_ = conn.SetWriteDeadline(time.Now().Add(5 * time.Second))
+					_, first, err := conn.ReadMessage()
+					if err != nil {
+						return fmt.Errorf("initial create: %w", err)
+					}
+					if gjson.GetBytes(first, "type").String() != "response.create" {
+						return fmt.Errorf("expected initial create, got %s", first)
+					}
+					if err := conn.WriteMessage(websocket.TextMessage, []byte(`{"type":"response.created","response":{"id":"r1","output":[]}}`)); err != nil {
+						return err
+					}
+					if !revoke {
+						if err := conn.WriteMessage(websocket.TextMessage, []byte(`{"type":"response.output_item.added","output_index":0,"item":{"id":"reason-1","type":"reasoning","summary":[]}}`)); err != nil {
+							return err
+						}
+					}
+					_, control, err := conn.ReadMessage()
+					if revoke {
+						if err == nil {
+							return fmt.Errorf("revoked credential forwarded frame: %s", control)
+						}
+						if timeout, ok := err.(net.Error); ok && timeout.Timeout() {
+							return fmt.Errorf("revoked connection did not close: %w", err)
+						}
+						return nil
+					}
+					if err != nil {
+						return fmt.Errorf("interrupt: %w", err)
+					}
+					if !bytes.Equal(control, interrupt) {
+						return fmt.Errorf("interrupt changed: %s", control)
+					}
+					for _, event := range [][]byte{accepted, discarded, incomplete} {
+						if err := conn.WriteMessage(websocket.TextMessage, event); err != nil {
+							return err
+						}
+					}
+					_, followup, err := conn.ReadMessage()
+					if err != nil {
+						return fmt.Errorf("follow-up create: %w", err)
+					}
+					if gjson.GetBytes(followup, "type").String() != "response.create" ||
+						gjson.GetBytes(followup, "previous_response_id").String() != "r1" ||
+						gjson.GetBytes(followup, "input.0.content.0.text").String() != "second prompt" {
+						return fmt.Errorf("invalid follow-up create: %s", followup)
+					}
+					for _, event := range []string{
+						`{"type":"response.created","response":{"id":"r2","output":[]}}`,
+						`{"type":"response.completed","response":{"id":"r2","status":"completed","output":[]}}`,
+					} {
+						if err := conn.WriteMessage(websocket.TextMessage, []byte(event)); err != nil {
+							return err
+						}
+					}
+					// The same connection remains open until the downstream session ends.
+					_, extra, err := conn.ReadMessage()
+					if err == nil {
+						return fmt.Errorf("unexpected extra request: %s", extra)
+					}
+					if timeout, ok := err.(net.Error); ok && timeout.Timeout() {
+						return fmt.Errorf("session did not close: %w", err)
+					}
+					return nil
+				}()
+			}))
+			defer server.Close()
+			ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+			defer cancel()
+			input := make(chan core.WebsocketInput, 2)
+			ctx = core.WithWebsocketInput(core.WithDownstreamWebsocket(ctx), input)
+			ctx = core.WithWebsocketAuthCheck(ctx, func(authID string) bool {
+				if authID != "interrupt-auth" {
+					wrongAuthID.Store(true)
+					return false
+				}
+				return !disabled.Load()
+			})
+			exec := NewCodexWebsocketsExecutor(&config.Config{Codex: config.CodexConfig{ResponseSteering: true}})
+			exec.store = &codexWebsocketSessionStore{sessions: make(map[string]*codexWebsocketSession)}
+			auth := &cliproxyauth.Auth{ID: "interrupt-auth", Provider: "codex", Attributes: map[string]string{"api_key": "test-key", "base_url": server.URL, "websockets": "true"}}
+			req := core.Request{Model: "gpt-6-astra", Payload: []byte(`{"model":"gpt-6-astra","instructions":"Initial settings","input":[]}`)}
+			opts := core.Options{SourceFormat: sdktranslator.FromString("codex"), Metadata: map[string]any{core.ExecutionSessionMetadataKey: "interrupt-test"}}
+			result, err := exec.ExecuteStream(ctx, auth, req, opts)
+			if err != nil {
+				t.Fatal(err)
+			}
+			seenAccepted, seenDiscarded, seenIncomplete := false, false, false
+		finished:
+			for {
+				select {
+				case chunk, ok := <-result.Chunks:
+					if !ok {
+						t.Fatal("stream closed before expected result")
+					}
+					if chunk.Err != nil {
+						if revoke && strings.Contains(chunk.Err.Error(), "websocket credential is no longer enabled") {
+							break finished
+						}
+						t.Fatal(chunk.Err)
+					}
+					event := gjson.GetBytes(chunk.Payload, "type").String()
+					id := gjson.GetBytes(chunk.Payload, "response.id").String()
+					switch event {
+					case "response.created":
+						if id == "r1" {
+							disabled.Store(revoke)
+							input <- core.WebsocketInput{Payload: interrupt}
+						} else if id != "r2" || !seenIncomplete {
+							t.Fatalf("unexpected successor before continuation: %s", chunk.Payload)
+						}
+					case "response.interrupt.accepted":
+						if !bytes.Equal(chunk.Payload, accepted) {
+							t.Fatalf("interrupt acknowledgement changed: %s", chunk.Payload)
+						}
+						seenAccepted = true
+					case "response.output_item.interrupted":
+						if !bytes.Equal(chunk.Payload, discarded) {
+							t.Fatalf("discarded-item event changed: %s", chunk.Payload)
+						}
+						seenDiscarded = true
+					case "response.incomplete":
+						if !seenAccepted || !seenDiscarded || !bytes.Equal(chunk.Payload, incomplete) {
+							t.Fatalf("interruption boundary changed or out of order: %s", chunk.Payload)
+						}
+						seenIncomplete = true
+						input <- core.WebsocketInput{Payload: []byte(`{"type":"response.create","previous_response_id":"r1","input":[{"role":"user","content":[{"type":"input_text","text":"second prompt"}]}]}`)}
+					case "response.completed":
+						if id != "r2" || !seenIncomplete || revoke {
+							t.Fatalf("unexpected completion: %s", chunk.Payload)
+						}
+						break finished
+					case "error", "response.failed":
+						t.Fatalf("unexpected protocol error: %s", chunk.Payload)
+					}
+				case <-ctx.Done():
+					t.Fatal(ctx.Err())
+				}
+			}
+			cancel()
+			select {
+			case err := <-serverResult:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-time.After(3 * time.Second):
+				t.Fatal("upstream session did not close")
+			}
+			for range result.Chunks {
+			}
+			if connections.Load() != 1 || wrongAuthID.Load() {
+				t.Fatalf("session changed: connections=%d wrong_auth_id=%v", connections.Load(), wrongAuthID.Load())
+			}
+		})
+	}
+}
diff --git a/sdk/api/handlers/openai/openai_responses_interrupt_integration_test.go b/sdk/api/handlers/openai/openai_responses_interrupt_integration_test.go
new file mode 100644
--- /dev/null
+++ b/sdk/api/handlers/openai/openai_responses_interrupt_integration_test.go
@@ -0,0 +1,151 @@
+package openai
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/gorilla/websocket"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	runtimeexecutor "github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/api/handlers"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"github.com/tidwall/gjson"
+)
+
+// The real Gin route forwards interrupt while the first response is active.
+// Only upstream emits acknowledgement and the interrupted terminal boundary.
+func TestResponsesInterruptFullDuplexIntegration(t *testing.T) {
+	var connections atomic.Int32
+	result := make(chan error, 1)
+	interrupt := []byte(`{ "type": "response.interrupt", "response_id": "r1", "mode": "discard_partial_items", "future": true }`)
+	accepted := []byte(`{"type":"response.interrupt.accepted","response_id":"r1","sequence_number":3}`)
+	discarded := []byte(`{"type":"response.output_item.interrupted","response_id":"r1","item_id":"reason-1","output_index":0,"sequence_number":4}`)
+	incomplete := []byte(`{"type":"response.incomplete","sequence_number":5,"response":{"id":"r1","status":"incomplete","incomplete_details":{"reason":"interrupted"},"output":[],"usage":{"input_tokens":10,"output_tokens":2,"total_tokens":12,"input_tokens_details":{"cached_tokens":0},"output_tokens_details":{"reasoning_tokens":2}}}}`)
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		connections.Add(1)
+		result <- func() error {
+			if r.Header.Get("Authorization") != "Bearer test-key" {
+				return fmt.Errorf("upstream credential changed")
+			}
+			c, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+			if err != nil {
+				return err
+			}
+			defer func() { _ = c.Close() }()
+			_ = c.SetReadDeadline(time.Now().Add(8 * time.Second))
+			_, initial, err := c.ReadMessage()
+			if err != nil || gjson.GetBytes(initial, "type").String() != "response.create" {
+				return fmt.Errorf("initial create: %s, %v", initial, err)
+			}
+			if err := c.WriteMessage(websocket.TextMessage, []byte(`{"type":"response.created","response":{"id":"r1"}}`)); err != nil {
+				return err
+			}
+			_, control, err := c.ReadMessage()
+			if err != nil || !bytes.Equal(control, interrupt) {
+				return fmt.Errorf("interrupt changed: %s, %v", control, err)
+			}
+			for _, event := range [][]byte{accepted, discarded, incomplete} {
+				if err := c.WriteMessage(websocket.TextMessage, event); err != nil {
+					return err
+				}
+			}
+			_, followup, err := c.ReadMessage()
+			if err != nil || gjson.GetBytes(followup, "type").String() != "response.create" || gjson.GetBytes(followup, "previous_response_id").String() != "r1" || gjson.GetBytes(followup, "input.0.content.0.text").String() != "continue" {
+				return fmt.Errorf("explicit continuation changed: %s, %v", followup, err)
+			}
+			for _, event := range []string{`{"type":"response.created","response":{"id":"r2"}}`, `{"type":"response.completed","response":{"id":"r2","output":[]}}`} {
+				if err := c.WriteMessage(websocket.TextMessage, []byte(event)); err != nil {
+					return err
+				}
+			}
+			if _, extra, err := c.ReadMessage(); err == nil {
+				return fmt.Errorf("unexpected extra request: %s", extra)
+			}
+			return nil
+		}()
+	}))
+	defer upstream.Close()
+	cfg, err := config.ParseConfigBytes([]byte("oauth: {providers: {codex: {response-steering: true}}}\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Match the server's effective SDK flag and use an eligible OAuth credential.
+	cfg.CodexResponseSteering = cfg.Codex.ResponseSteering
+	manager := coreauth.NewManager(nil, nil, nil)
+	manager.SetConfig(cfg)
+	manager.RegisterExecutor(runtimeexecutor.NewCodexAutoExecutor(cfg))
+	const authID = "interrupt-full-duplex-integration"
+	if _, err := manager.Register(context.Background(), &coreauth.Auth{ID: authID, Provider: "codex", Status: coreauth.StatusActive, Attributes: map[string]string{"base_url": upstream.URL, "websockets": "true"}, Metadata: map[string]any{"access_token": "test-key"}}); err != nil {
+		t.Fatal(err)
+	}
+	registry.GetGlobalRegistry().RegisterClient(authID, "codex", []*registry.ModelInfo{{ID: "interrupt-test-model"}})
+	defer registry.GetGlobalRegistry().UnregisterClient(authID)
+	h := NewOpenAIResponsesAPIHandler(handlers.NewBaseAPIHandlers(&cfg.SDKConfig, manager))
+	router := gin.New()
+	router.GET("/v1/responses", h.ResponsesWebsocket)
+	downstream := httptest.NewServer(router)
+	defer downstream.Close()
+	c, _, err := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(downstream.URL, "http")+"/v1/responses", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = c.Close() }()
+	_ = c.SetReadDeadline(time.Now().Add(10 * time.Second))
+	send := func(payload []byte) {
+		if err := c.WriteMessage(websocket.TextMessage, payload); err != nil {
+			t.Fatal(err)
+		}
+	}
+	send([]byte(`{"type":"response.create","model":"interrupt-test-model","input":[]}`))
+	boundary := 0
+	for {
+		_, payload, err := c.ReadMessage()
+		if err != nil {
+			t.Fatalf("downstream closed before completion: %v", err)
+		}
+		switch gjson.GetBytes(payload, "type").String() {
+		case "response.created":
+			if gjson.GetBytes(payload, "response.id").String() == "r1" {
+				send(interrupt)
+			} else if boundary != 3 {
+				t.Fatalf("successor appeared before interrupted boundary: %s", payload)
+			}
+		case "response.interrupt.accepted", "response.output_item.interrupted", "response.incomplete":
+			if boundary >= 3 || !bytes.Equal(payload, [][]byte{accepted, discarded, incomplete}[boundary]) {
+				t.Fatalf("upstream interrupt event changed or reordered: %s", payload)
+			}
+			boundary++
+			if boundary == 3 {
+				send([]byte(`{"type":"response.create","previous_response_id":"r1","input":[{"role":"user","content":[{"type":"input_text","text":"continue"}]}]}`))
+			}
+		case "response.completed":
+			if boundary != 3 || gjson.GetBytes(payload, "response.id").String() != "r2" {
+				t.Fatalf("unexpected completion: %s", payload)
+			}
+			_ = c.Close()
+			select {
+			case err := <-result:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-time.After(3 * time.Second):
+				t.Fatal("upstream session did not close")
+			}
+			if connections.Load() != 1 {
+				t.Fatalf("unexpected reconnect/replay: %d", connections.Load())
+			}
+			return
+		case "error", "response.failed":
+			t.Fatalf("unexpected protocol error: %s", payload)
+		}
+	}
+}
