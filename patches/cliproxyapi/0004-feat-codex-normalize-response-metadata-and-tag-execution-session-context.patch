+	original := []byte(" \n{\"type\":\"codex.response.metadata\",\"headers\":{\"x-models-etag\":\"catalog\",\"x-codex-turn-state\":\"opaque\"},\"future\":true}\t ")
+	want := [][]byte{original, codexTurnStateMetadataSupplement(original)}
+	result := make(chan error, 1)
+	timeline := &metadataTimeline{}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+		if err != nil {
+			result <- err
+			return
+		}
+		defer conn.Close()
+		result <- writeResponsesWebsocketPayload(newResponsesWebsocketWriter(conn), timeline, original, time.Now())
+	}))
+	defer server.Close()
+	conn, _, err := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(server.URL, "http"), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	conn.SetReadDeadline(time.Now().Add(5 * time.Second))
+	for i, expected := range want {
+		_, got, err := conn.ReadMessage()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !bytes.Equal(got, expected) {
+			t.Fatalf("frame %d: %q != %q", i, got, expected)
+		}
+	}
+	if err := <-result; err != nil {
+		t.Fatal(err)
+	}
+	if len(timeline.frames) != len(want) {
+		t.Fatalf("timeline frames: %d", len(timeline.frames))
+	}
+	for i, expected := range want {
+		if !bytes.Equal(timeline.frames[i], expected) {
+			t.Fatalf("timeline %d changed", i)
+		}
+	}
+}
