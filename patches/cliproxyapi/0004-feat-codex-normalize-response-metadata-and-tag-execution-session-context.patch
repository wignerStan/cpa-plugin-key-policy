diff --git a/sdk/api/handlers/openai/openai_responses_metadata.go b/sdk/api/handlers/openai/openai_responses_metadata.go
new file mode 100644
index 0000000..08f869b
--- /dev/null
+++ b/sdk/api/handlers/openai/openai_responses_metadata.go
@@ -0,0 +1,47 @@
+package openai
+
+import (
+	"encoding/json"
+	"strings"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/util"
+	"github.com/tidwall/gjson"
+)
+
+// codexTurnStateMetadataSupplement leaves provider metadata intact for ETag
+// updates. Only a valid turn-state header needs a second event for persistence.
+func codexTurnStateMetadataSupplement(payload []byte) []byte {
+	if util.GetGJSONBytesNoCopy(payload, "type").Str != "codex.response.metadata" {
+		return nil
+	}
+	if !json.Valid(payload) {
+		return nil
+	}
+	headers := util.GetGJSONBytesNoCopy(payload, "headers")
+	if !headers.IsObject() {
+		return nil
+	}
+	var raw string
+	headers.ForEach(func(key, value gjson.Result) bool {
+		if !strings.EqualFold(key.Str, "x-codex-turn-state") {
+			return true
+		}
+		first := value
+		for first.IsArray() {
+			first = first.Get("0")
+		}
+		if first.Type != gjson.String || strings.TrimSpace(first.Str) == "" {
+			return true
+		}
+		raw = first.Raw
+		return false
+	})
+	if raw == "" {
+		return nil
+	}
+	const prefix = `{"type":"response.metadata","headers":{"x-codex-turn-state":`
+	out := make([]byte, 0, len(prefix)+len(raw)+2)
+	out = append(out, prefix...)
+	out = append(out, raw...)
+	return append(out, '}', '}')
+}
