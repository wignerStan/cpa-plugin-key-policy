+func TestCodexMetadataSSEPreservesOriginalAndSupplementOrder(t *testing.T) {
+	payload := ` {"type":"codex.response.metadata","headers":{"x-models-etag":"catalog","x-codex-turn-state":["opaque"]},"future":true} `
+	original := []byte(": upstream comment\r\nid: 7\r\nevent: codex.response.metadata\r\ndata: " + payload + "\r\n\r\n")
+	canonical := []byte("event: response.metadata\ndata: {\"type\":\"response.metadata\",\"headers\":{\"x-codex-turn-state\":\"canonical\"},\"future\":true}\n\n")
+	etagOnly := []byte("event: codex.response.metadata\ndata: {\"type\":\"codex.response.metadata\",\"headers\":{\"x-models-etag\":\"catalog\"}}\n\n")
+	supplement := responsesSSEFrameWithEventAndData("response.metadata", codexTurnStateMetadataSupplement([]byte(payload)))
+	for _, official := range []bool{false, true} {
+		wire := bytes.Join([][]byte{original, etagOnly, canonical}, nil)
+		want := canonical
+		if official {
+			want = bytes.Join([][]byte{original, supplement, etagOnly, canonical}, nil)
+		}
+		splits := []int{0, len(wire)}
+		// Fragment every metadata data-body position; complete field names are
+		// required by the existing framer field-recovery contract.
+		for split := bytes.Index(original, []byte("data:")) + len("data:"); split <= len(original); split++ {
+			splits = append(splits, split)
+		}
+		for _, split := range splits {
+			var out bytes.Buffer
+			framer := &responsesSSEFramer{isCodexClient: official}
+			framer.WriteChunk(&out, wire[:split])
+			framer.WriteChunk(&out, wire[split:])
+			framer.Flush(&out)
+			if !bytes.Equal(out.Bytes(), want) {
+				t.Fatalf("official=%t split=%d: SSE changed: %q", official, split, out.Bytes())
+			}
+		}
+	}
+}
