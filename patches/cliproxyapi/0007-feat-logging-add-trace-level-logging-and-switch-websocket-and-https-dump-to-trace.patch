diff --git a/internal/logging/codex_dump.go b/internal/logging/codex_dump.go
index c5d39049..35cbabad 100644
--- a/internal/logging/codex_dump.go
+++ b/internal/logging/codex_dump.go
@@ -22,13 +22,16 @@ func IsLinuxOS() bool {
 }
 
 // ConfigureCodexDump sets whether Codex WS/HTTPS dump is enabled via config.
-// Dump is linux-only and default off.
+// Dump is linux-only and default off. When enabled on Linux, it sets logrus to TraceLevel.
 func ConfigureCodexDump(enabled bool) {
 	if !IsLinuxOS() {
 		codexDumpActive.Store(false)
 		return
 	}
 	codexDumpActive.Store(enabled)
+	if enabled {
+		log.SetLevel(log.TraceLevel)
+	}
 }
 
 // CodexDumpEnabled reports whether dump capture is active.
@@ -40,7 +43,7 @@ func CodexDumpEnabled() bool {
 	return codexDumpActive.Load()
 }
 
-// CodexDumpFrame logs one websocket text frame (any leg) to logrus at debug level.
+// CodexDumpFrame logs one websocket text frame (any leg) to logrus at trace level.
 // leg examples: client_in, client_out, upstream_out, upstream_in.
 func CodexDumpFrame(sessionID, leg string, payload []byte) {
 	if !CodexDumpEnabled() {
@@ -59,10 +62,10 @@ func CodexDumpFrame(sessionID, leg string, payload []byte) {
 		"leg":        strings.TrimSpace(leg),
 		"type":       eventType,
 		"size":       len(payload),
-	}).Debugf("ws dump: %s", string(trimmed))
+	}).Tracef("ws dump: %s", string(trimmed))
 }
 
-// CodexDumpBinaryFrame logs a non-text websocket frame to logrus at debug level.
+// CodexDumpBinaryFrame logs a non-text websocket frame to logrus at trace level.
 func CodexDumpBinaryFrame(sessionID, leg string, payload []byte) {
 	if !CodexDumpEnabled() || len(payload) == 0 {
 		return
@@ -74,10 +77,10 @@ func CodexDumpBinaryFrame(sessionID, leg string, payload []byte) {
 		"leg":        strings.TrimSpace(leg),
 		"binary":     true,
 		"size":       len(payload),
-	}).Debugf("ws binary dump: %s", base64.StdEncoding.EncodeToString(payload))
+	}).Tracef("ws binary dump: %s", base64.StdEncoding.EncodeToString(payload))
 }
 
-// CodexDumpHTTPRequest logs an HTTP request (upstream_out or client_in) to logrus at debug level.
+// CodexDumpHTTPRequest logs an HTTP request (upstream_out or client_in) to logrus at trace level.
 func CodexDumpHTTPRequest(sessionID, leg, method, url string, headers http.Header, body []byte) {
 	if !CodexDumpEnabled() {
 		return
@@ -91,10 +94,10 @@ func CodexDumpHTTPRequest(sessionID, leg, method, url string, headers http.Heade
 		"method":     strings.TrimSpace(method),
 		"url":        strings.TrimSpace(url),
 		"size":       len(body),
-	}).Debugf("https dump request: %s", string(trimmed))
+	}).Tracef("https dump request: %s", string(trimmed))
 }
 
-// CodexDumpHTTPResponse logs an HTTP response metadata/body to logrus at debug level.
+// CodexDumpHTTPResponse logs an HTTP response metadata/body to logrus at trace level.
 func CodexDumpHTTPResponse(sessionID, leg string, status int, headers http.Header, body []byte) {
 	if !CodexDumpEnabled() {
 		return
@@ -107,10 +110,10 @@ func CodexDumpHTTPResponse(sessionID, leg string, status int, headers http.Heade
 		"leg":        strings.TrimSpace(leg),
 		"status":     status,
 		"size":       len(body),
-	}).Debugf("https dump response: %s", string(trimmed))
+	}).Tracef("https dump response: %s", string(trimmed))
 }
 
-// CodexDumpHTTPChunk logs an HTTP response chunk (upstream_in or client_out) to logrus at debug level.
+// CodexDumpHTTPChunk logs an HTTP response chunk (upstream_in or client_out) to logrus at trace level.
 func CodexDumpHTTPChunk(sessionID, leg string, chunk []byte) {
 	if !CodexDumpEnabled() || len(chunk) == 0 {
 		return
@@ -122,7 +125,7 @@ func CodexDumpHTTPChunk(sessionID, leg string, chunk []byte) {
 		"session_id": strings.TrimSpace(sessionID),
 		"leg":        strings.TrimSpace(leg),
 		"size":       len(chunk),
-	}).Debugf("https dump chunk: %s", string(trimmed))
+	}).Tracef("https dump chunk: %s", string(trimmed))
 }
 
 func bytesTrimSpace(b []byte) []byte {
