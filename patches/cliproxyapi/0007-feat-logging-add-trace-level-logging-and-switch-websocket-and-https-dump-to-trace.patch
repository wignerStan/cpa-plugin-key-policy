+++ b/internal/logging/codex_dump_test.go
@@ -26,7 +26,6 @@ func TestCodexDumpStandardLog(t *testing.T) {
 	origOutput := log.StandardLogger().Out
 	origLevel := log.GetLevel()
 	log.SetOutput(&buf)
-	log.SetLevel(log.DebugLevel)
 	defer func() {
 		log.SetOutput(origOutput)
 		log.SetLevel(origLevel)
@@ -37,6 +36,9 @@ func TestCodexDumpStandardLog(t *testing.T) {
 	if !CodexDumpEnabled() {
 		t.Fatal("CodexDumpEnabled() = false, want true on linux")
 	}
+	if log.GetLevel() != log.TraceLevel {
+		t.Fatalf("log level = %v, want TraceLevel", log.GetLevel())
+	}
 
 	CodexDumpFrame("sess-ws", "client_in", []byte(`{"type":"response.create","model":"gpt-6-astra"}`))
 	CodexDumpHTTPRequest("sess-http", "upstream_out", "POST", "https://api.openai.com/v1/responses", http.Header{"Authorization": []string{"Bearer tok"}}, []byte(`{"model":"gpt-6-astra"}`))
@@ -44,6 +46,9 @@ func TestCodexDumpStandardLog(t *testing.T) {
 	CodexDumpHTTPChunk("sess-http", "upstream_in", []byte("data: chunk\n\n"))
 
 	out := buf.String()
+	if !strings.Contains(out, "level=trace") {
+		t.Fatalf("expected log output to contain 'level=trace', got: %s", out)
+	}
 	if !strings.Contains(out, "ws dump:") {
 		t.Fatalf("expected log output to contain 'ws dump:', got: %s", out)
 	}
