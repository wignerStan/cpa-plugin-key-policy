diff --git a/internal/logging/codex_response_metadata.go b/internal/logging/codex_response_metadata.go
new file mode 100644
index 00000000..35aeb35a
--- /dev/null
+++ b/internal/logging/codex_response_metadata.go
@@ -0,0 +1,25 @@
+package logging
+
+import (
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+const (
+	codexResponseMetadataType = "codex.response.metadata"
+	responseMetadataType      = "response.metadata"
+)
+
+// NormalizeCodexResponseMetadataDownstream rewrites upstream codex.response.metadata
+// to response.metadata so official Codex clients persist x-codex-turn-state. Only
+// the JSON "type" field changes; headers and other fields are preserved.
+func NormalizeCodexResponseMetadataDownstream(payload []byte) []byte {
+	if gjson.GetBytes(payload, "type").String() != codexResponseMetadataType {
+		return payload
+	}
+	out, err := sjson.SetBytes(payload, "type", responseMetadataType)
+	if err != nil || len(out) == 0 {
+		return payload
+	}
+	return out
+}
diff --git a/internal/logging/codex_response_metadata_test.go b/internal/logging/codex_response_metadata_test.go
new file mode 100644
index 00000000..893da2cd
--- /dev/null
+++ b/internal/logging/codex_response_metadata_test.go
@@ -0,0 +1,22 @@
+package logging
+
+import (
+	"testing"
+
+	"github.com/tidwall/gjson"
+)
+
+func TestNormalizeCodexResponseMetadataDownstream(t *testing.T) {
+	in := []byte(`{"type":"codex.response.metadata","headers":{"x-codex-turn-state":"tok-abc","x-models-etag":"W/\"x\""}}`)
+	out := NormalizeCodexResponseMetadataDownstream(in)
+	if gjson.GetBytes(out, "type").String() != responseMetadataType {
+		t.Fatalf("type=%q want %q", gjson.GetBytes(out, "type").String(), responseMetadataType)
+	}
+	if gjson.GetBytes(out, "headers.x-codex-turn-state").String() != "tok-abc" {
+		t.Fatalf("turn-state changed: %s", out)
+	}
+	unchanged := NormalizeCodexResponseMetadataDownstream([]byte(`{"type":"response.created"}`))
+	if string(unchanged) != `{"type":"response.created"}` {
+		t.Fatalf("unexpected rewrite: %s", unchanged)
+	}
+}
