+func classifiedTraceViewScoped(value any, inMetadata bool) any {
 	switch typed := value.(type) {
 	case map[string]any:
 		redacted := make(map[string]any, len(typed))
 		for key, item := range typed {
+			metaChild := inMetadata || isMetadataContainer(key)
 			if sensitiveTraceField(key) {
-				redacted[key] = "<redacted>"
-			} else if publicTracePayloadField(key) {
-				redacted[key] = classifiedTraceView(item)
+				redacted[key] = hashTraceValue(item)
+			} else if inMetadata || publicTracePayloadField(key) || isMetadataContainer(key) {
+				redacted[key] = classifiedTraceViewScoped(item, metaChild)
 			}
 		}
 		return redacted
