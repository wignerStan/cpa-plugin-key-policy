 }
 
+func isLBCookie(name string) bool {
+	n := strings.ToLower(strings.TrimSpace(name))
+	switch {
+	case strings.HasPrefix(n, "__cf"), strings.HasPrefix(n, "cf_"), strings.HasPrefix(n, "_cf"),
+		strings.Contains(n, "clearance"), strings.HasPrefix(n, "aws"),
+		strings.Contains(n, "alb"), strings.Contains(n, "gclb"),
+		strings.Contains(n, "anycast"), strings.Contains(n, "ray"),
+		strings.Contains(n, "route"), strings.Contains(n, "affinity"),
+		n == "lb", strings.HasPrefix(n, "lb_"), strings.HasPrefix(n, "lb-"):
+		return true
+	default:
+		return false
+	}
+}
+
+func isAuthOrSessionCookie(name string) bool {
+	n := strings.ToLower(strings.TrimSpace(name))
+	switch {
+	case strings.Contains(n, "session"), strings.Contains(n, "token"),
+		strings.Contains(n, "auth"), strings.Contains(n, "secret"),
+		strings.Contains(n, "secure"), strings.Contains(n, "jwt"),
+		strings.Contains(n, "key"), strings.Contains(n, "sid"),
+		strings.HasPrefix(n, "__secure-"), strings.HasPrefix(n, "__host-"),
+		strings.Contains(n, "credential"), strings.Contains(n, "login"):
+		return true
+	default:
+		return false
+	}
+}
+
+func formatCookieHeader(raw string) string {
+	parts := strings.Split(raw, ";")
+	formatted := make([]string, 0, len(parts))
+	for _, part := range parts {
+		trimmed := strings.TrimSpace(part)
+		if trimmed == "" {
+			continue
+		}
+		eq := strings.IndexByte(trimmed, '=')
+		if eq == -1 {
+			formatted = append(formatted, trimmed)
+			continue
+		}
+		name := strings.TrimSpace(trimmed[:eq])
+		val := strings.TrimSpace(trimmed[eq+1:])
+		if isLBCookie(name) {
+			formatted = append(formatted, fmt.Sprintf("%s=%s", name, val))
+		} else if isAuthOrSessionCookie(name) {
+			formatted = append(formatted, fmt.Sprintf("%s=%s", name, hashTraceString(val)))
+		} else {
+			formatted = append(formatted, fmt.Sprintf("%s=%s", name, hashTraceString(val)))
+		}
+	}
+	return strings.Join(formatted, "; ")
+}
+
+func formatSetCookieHeader(raw string) string {
+	parts := strings.Split(raw, ";")
+	if len(parts) == 0 {
+		return raw
+	}
+	first := strings.TrimSpace(parts[0])
+	eq := strings.IndexByte(first, '=')
+	if eq == -1 {
+		return raw
+	}
+	name := strings.TrimSpace(first[:eq])
+	val := strings.TrimSpace(first[eq+1:])
+	var formattedFirst string
+	if isLBCookie(name) {
+		formattedFirst = fmt.Sprintf("%s=%s", name, val)
+	} else if isAuthOrSessionCookie(name) {
+		formattedFirst = fmt.Sprintf("%s=%s", name, hashTraceString(val))
+	} else {
+		formattedFirst = fmt.Sprintf("%s=%s", name, hashTraceString(val))
+	}
+
+	remaining := make([]string, 0, len(parts))
+	remaining = append(remaining, formattedFirst)
+	for _, p := range parts[1:] {
+		remaining = append(remaining, strings.TrimSpace(p))
+	}
+	return strings.Join(remaining, "; ")
+}
+
+func isLBHeader(name string) bool {
+	n := strings.ToLower(strings.TrimSpace(name))
+	switch {
+	case strings.HasPrefix(n, "cf-"), n == "cfray", n == "cf-ray",
+		strings.HasPrefix(n, "x-cf-"), strings.HasPrefix(n, "x-amz-"),
+		strings.HasPrefix(n, "x-edge-"), strings.HasPrefix(n, "x-lb-"),
+		strings.Contains(n, "anycast"), strings.Contains(n, "ray"),
+		n == "server", n == "via", n == "x-served-by", n == "x-cache":
+		return true
+	default:
+		return false
+	}
+}
+
+func formatHeaderValue(key string, values []string) (string, bool) {
+	kLower := strings.ToLower(strings.TrimSpace(key))
+	switch kLower {
+	case "cookie":
+		var out []string
+		for _, v := range values {
+			out = append(out, formatCookieHeader(v))
+		}
+		return strings.Join(out, "; "), true
+	case "set-cookie":
+		var out []string
+		for _, v := range values {
+			out = append(out, formatSetCookieHeader(v))
+		}
+		return strings.Join(out, ", "), true
+	case "authorization":
+		val := strings.TrimSpace(strings.Join(values, " "))
+		if strings.HasPrefix(strings.ToLower(val), "bearer ") {
+			token := strings.TrimSpace(val[7:])
+			return "Bearer " + hashTraceString(token), true
+		}
+		return hashTraceString(val), true
+	}
+
+	if isLBHeader(key) || publicTraceHeader(key) {
+		return strings.Join(values, ", "), true
+	}
+
+	if sensitiveTraceField(key) {
+		return hashTraceString(strings.Join(values, ", ")), true
+	}
+
+	return "", false
+}
+
 func addHeaderView(fields log.Fields, headers http.Header) {
 	if len(headers) == 0 {
 		return
@@ -395,15 +576,13 @@ func addHeaderView(fields log.Fields, headers http.Header) {
 	sort.Strings(keys)
 	parts := make([]string, 0, len(keys))
 	for _, key := range keys {
-		value := ""
-		if sensitiveTraceField(key) {
-			value = "<redacted>"
-		} else if publicTraceHeader(key) {
-			value = strings.Join(headers.Values(key), ", ")
-		} else {
-			continue
+		values := headers[key]
+		if len(values) == 0 {
+			values = headers.Values(key)
+		}
+		if formatted, ok := formatHeaderValue(key, values); ok && formatted != "" {
+			parts = append(parts, fmt.Sprintf("%s=%q", key, formatted))
 		}
-		parts = append(parts, fmt.Sprintf("%s=%q", key, value))
 	}
 	fields["headers"] = strings.Join(parts, " ")
 }
