+func TestCodexTraceAndDumpAreIndependentSettings(t *testing.T) {
+	output := captureCodexDumpLogs(t)
+	payload := []byte(`{"type":"response.create","model":"gpt-6-astra","usage":{"prompt_tokens":42}}`)
+
+	// 1. Trace ON, Dump OFF: trace logs decision & metadata, but no dump artifacts on disk.
+	log.SetLevel(log.TraceLevel)
+	logDir1 := t.TempDir()
+	ConfigureCodexDump(false, logDir1)
+	CodexDumpFrame("session-1", "client_in", payload)
+	if output.Len() == 0 {
+		t.Fatal("trace on want log output, got empty")
+	}
+	if !strings.Contains(output.String(), "response.create") || !strings.Contains(output.String(), "gpt-6-astra") {
+		t.Fatalf("trace view missing decision metadata: %s", output.String())
+	}
+	if _, err := os.Stat(filepath.Join(logDir1, "codex-dumps")); !os.IsNotExist(err) {
+		t.Fatalf("dump off should not create codex-dumps directory, stat error = %v", err)
+	}
+
+	if runtime.GOOS != "linux" {
+		return
+	}
+
+	// 2. Trace OFF (InfoLevel), Dump ON: suppresses trace log output, preserves payload dump on disk.
+	output.Reset()
+	log.SetLevel(log.InfoLevel)
+	logDir2 := t.TempDir()
+	ConfigureCodexDump(true, logDir2)
+	CodexDumpFrame("session-2", "client_in", payload)
+	if output.Len() != 0 {
+		t.Fatalf("trace off should not emit trace logs, got: %s", output.String())
+	}
+	files, err := os.ReadDir(filepath.Join(logDir2, "codex-dumps"))
+	if err != nil {
+		t.Fatalf("read capture directory: %v", err)
+	}
+	if len(files) != 1 {
+		t.Fatalf("dump on should preserve 1 artifact, got %d", len(files))
+	}
+	captured, err := os.ReadFile(filepath.Join(logDir2, "codex-dumps", files[0].Name()))
+	if err != nil {
+		t.Fatalf("read capture artifact: %v", err)
+	}
+	if !bytes.Equal(captured, payload) {
+		t.Fatalf("captured payload mismatch: got %q, want %q", captured, payload)
+	}
+}
