+func initCodexDumpDir(dir string) {
+	if codexDumpDirInited.Load() {
+		return
+	}
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return
+	}
+	var total int64
+	for _, entry := range entries {
+		if entry.Type()&os.ModeSymlink != 0 || !strings.HasSuffix(entry.Name(), ".raw") {
+			continue
+		}
+		info, err := entry.Info()
+		if err == nil && info.Mode().IsRegular() {
+			total += info.Size()
+		}
+	}
+	codexDumpTotalBytes.Store(total)
+	codexDumpDirInited.Store(true)
