+func isDumpablePayload(eventType string, isChunk bool) bool {
+	if isChunk {
+		return false
+	}
+	if eventType != "" {
+		if strings.HasSuffix(eventType, ".delta") ||
+			eventType == "response.in_progress" ||
+			eventType == "response.output_item.added" ||
+			eventType == "responsesapi.websocket_timing" {
+			return false
+		}
+	}
+	return true
+}
