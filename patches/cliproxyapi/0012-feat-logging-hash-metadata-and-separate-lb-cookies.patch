+	logDir1 := t.TempDir()
+	ConfigureCodexDump(false, logDir1)
+	CodexDumpFrame("session-1", "client_in", payload)
+	if output.Len() == 0 {
+		t.Fatal("trace on want log output, got empty")
+	}
+	if !strings.Contains(output.String(), "response.create") || !strings.Contains(output.String(), "gpt-6-astra") {
+		t.Fatalf("trace view missing decision metadata: %s", output.String())
+	}
+	if _, err := os.Stat(filepath.Join(logDir1, "codex-dumps")); !os.IsNotExist(err) {
+		t.Fatalf("dump off should not create codex-dumps directory, stat error = %v", err)
+	}
+
+	if runtime.GOOS != "linux" {
+		return
+	}
+
+	// 2. Trace OFF (InfoLevel), Dump ON: suppresses trace log output, preserves payload dump on disk.
+	output.Reset()
+	log.SetLevel(log.InfoLevel)
+	logDir2 := t.TempDir()
+	ConfigureCodexDump(true, logDir2)
+	CodexDumpFrame("session-2", "client_in", payload)
+	if output.Len() != 0 {
+		t.Fatalf("trace off should not emit trace logs, got: %s", output.String())
+	}
