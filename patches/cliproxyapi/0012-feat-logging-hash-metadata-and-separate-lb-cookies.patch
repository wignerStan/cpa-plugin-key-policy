 )
 
+type streamBufferKey struct {
+	sessionID string
+	leg       string
+}
+
+type streamBuffer struct {
+	mu        sync.Mutex
+	sessionID string
+	leg       string
+	logDir    string
+	buf       bytes.Buffer
+	timer     *time.Timer
+	flushed   bool
+}
+
+func isStreamingFrame(eventType string) bool {
+	if eventType == "" {
+		return false
+	}
+	if strings.HasSuffix(eventType, ".delta") ||
+		eventType == "response.in_progress" ||
+		eventType == "response.output_item.added" ||
+		eventType == "response.created" ||
+		eventType == "responsesapi.websocket_timing" ||
+		eventType == "response.completed" ||
+		eventType == "response.done" {
+		return true
+	}
+	return false
+}
+
+func appendStreamBuffer(logDir, sessionID, leg string, payload []byte, isDelimiterNeeded, isComplete bool) {
+	if len(payload) == 0 || logDir == "" {
+		return
+	}
+	key := streamBufferKey{sessionID: strings.TrimSpace(sessionID), leg: strings.TrimSpace(leg)}
+
+	activeStreamBuffersMu.Lock()
+	sb, exists := activeStreamBuffers[key]
+	if !exists {
+		sb = &streamBuffer{
+			sessionID: sessionID,
+			leg:       leg,
+			logDir:    logDir,
+		}
+		activeStreamBuffers[key] = sb
+	}
+	activeStreamBuffersMu.Unlock()
+
+	sb.mu.Lock()
+	if sb.flushed {
+		sb.mu.Unlock()
+		return
+	}
+
+	sb.buf.Write(payload)
+	if isDelimiterNeeded && (len(payload) == 0 || payload[len(payload)-1] != '\n') {
+		sb.buf.WriteByte('\n')
+	}
+
+	if sb.buf.Len() >= maxStreamBufferBytes || isComplete {
+		sb.flushed = true
+		if sb.timer != nil {
+			sb.timer.Stop()
+			sb.timer = nil
+		}
+		activeStreamBuffersMu.Lock()
+		delete(activeStreamBuffers, key)
+		activeStreamBuffersMu.Unlock()
+
+		data := sb.buf.Bytes()
+		content := make([]byte, len(data))
+		copy(content, data)
+		sb.mu.Unlock()
+
+		_, _, _ = captureCodexDumpArtifact(logDir, sessionID, leg, content)
+		return
+	}
+
+	if sb.timer != nil {
+		sb.timer.Stop()
+	}
+	sb.timer = time.AfterFunc(streamFlushIdleTime, func() {
+		sb.mu.Lock()
+		if sb.flushed {
+			sb.mu.Unlock()
+			return
+		}
+		sb.flushed = true
+		activeStreamBuffersMu.Lock()
+		delete(activeStreamBuffers, key)
+		activeStreamBuffersMu.Unlock()
+
+		data := sb.buf.Bytes()
+		content := make([]byte, len(data))
+		copy(content, data)
+		sb.mu.Unlock()
+
+		if len(content) > 0 {
+			_, _, _ = captureCodexDumpArtifact(logDir, sessionID, leg, content)
+		}
+	})
+	sb.mu.Unlock()
+}
+
+// FlushAllStreamBuffers flushes all pending stream buffers to disk synchronously.
+func FlushAllStreamBuffers() {
+	activeStreamBuffersMu.Lock()
+	buffers := make([]*streamBuffer, 0, len(activeStreamBuffers))
+	keys := make([]streamBufferKey, 0, len(activeStreamBuffers))
+	for k, sb := range activeStreamBuffers {
+		buffers = append(buffers, sb)
+		keys = append(keys, k)
+	}
+	activeStreamBuffersMu.Unlock()
+
+	for i, sb := range buffers {
+		sb.mu.Lock()
+		if !sb.flushed {
+			sb.flushed = true
+			if sb.timer != nil {
+				sb.timer.Stop()
+				sb.timer = nil
+			}
+			activeStreamBuffersMu.Lock()
+			delete(activeStreamBuffers, keys[i])
+			activeStreamBuffersMu.Unlock()
+
+			data := sb.buf.Bytes()
+			if len(data) > 0 {
+				content := make([]byte, len(data))
+				copy(content, data)
+				_, _, _ = captureCodexDumpArtifact(sb.logDir, sb.sessionID, sb.leg, content)
+			}
+		}
+		sb.mu.Unlock()
+	}
+}
