+func TestCodexDumpMetadataUsesHashNotRedacted(t *testing.T) {
+	output := captureCodexDumpLogs(t)
+	log.SetLevel(log.TraceLevel)
+	ConfigureCodexDump(false, t.TempDir())
+	payload := []byte(`{"type":"response.create","model":"gpt-6-astra","client_metadata":{"turn_id":"turn-1","token":"secret-token","x-codex-turn-state":"ts-val"}}`)
+	CodexDumpFrame("session", "client_in", payload)
+	view := output.String()
+
+	if strings.Contains(view, "<redacted>") {
+		t.Fatalf("expected metadata not to be redacted with literal '<redacted>', got: %s", view)
+	}
+	if !strings.Contains(view, "hash:") {
+		t.Fatalf("expected token to be hashed with 'hash:', got: %s", view)
+	}
+	if !strings.Contains(view, "turn-1") {
+		t.Fatalf("expected public turn_id to be preserved, got: %s", view)
+	}
+}
+
