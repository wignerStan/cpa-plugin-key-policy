+func TestResponsesSSEFramerReadableSummaryAndStateTrace(t *testing.T) {
+	logger := log.StandardLogger()
+	oldOutput, oldFormatter, oldLevel := logger.Out, logger.Formatter, logger.GetLevel()
+	var trace, wire bytes.Buffer
+	logger.SetOutput(&trace)
+	logger.SetFormatter(&log.JSONFormatter{})
+	logger.SetLevel(log.TraceLevel)
+	requestlogging.ConfigureCodexDump(false, "")
+	t.Cleanup(func() {
+		requestlogging.ConfigureCodexDump(false, "")
+		logger.SetOutput(oldOutput)
+		logger.SetFormatter(oldFormatter)
+		logger.SetLevel(oldLevel)
+	})
+	framer := &responsesSSEFramer{isCodexClient: true, traceSessionID: "plain-sse-session"}
+	metadata := []byte("event: codex.response.metadata\ndata: {\"type\":\"codex.response.metadata\",\"headers\":{\"x-codex-turn-state\":\"plain-sse-state\",\"x-models-etag\":\"catalog\"}}\n\n")
+	framer.WriteChunk(&wire, metadata)
+	delta := []byte("event: response.reasoning_summary_text.delta\ndata: {\"type\":\"response.reasoning_summary_text.delta\",\"delta\":\"hidden-per-delta\"}\n\n")
+	before := trace.Len()
+	framer.WriteChunk(&wire, delta)
+	if trace.Len() != before {
+		t.Fatal("SSE delta generated TRACE")
+	}
+	done := []byte("event: response.reasoning_summary_text.done\ndata: {\"type\":\"response.reasoning_summary_text.done\",\"text\":\"I will inspect the route before calling the tool.\"}\n\n")
+	framer.WriteChunk(&wire, done)
+	if !strings.Contains(trace.String(), "I will inspect the route before calling the tool.") {
+		t.Fatal("summary not visible before tool event")
+	}
+	tool := []byte("event: response.output_item.done\ndata: {\"type\":\"response.output_item.done\",\"item\":{\"type\":\"function_call\",\"id\":\"tool-1\",\"name\":\"check\",\"arguments\":\"hidden-tool-arguments\"}}\n\n")
+	framer.WriteChunk(&wire, tool)
+	framer.Flush(&wire)
+	supplement := responsesSSEFrameWithEventAndData("response.metadata", codexTurnStateMetadataSupplement([]byte(`{"type":"codex.response.metadata","headers":{"x-codex-turn-state":"plain-sse-state"}}`)))
+	expected := bytes.Join([][]byte{metadata, supplement, delta, done, tool}, nil)
+	if !bytes.Equal(wire.Bytes(), expected) {
+		t.Fatal("TRACE altered SSE response bytes")
+	}
+	for _, visible := range []string{"plain-sse-state", "plain-sse-session", "https"} {
