 		for i, item := range typed {
-			redacted[i] = classifiedTraceView(item)
+			redacted[i] = classifiedTraceViewScoped(item, inMetadata)
 		}
 		return redacted
 	default:
@@ -358,12 +363,54 @@ func classifiedTraceView(value any) any {
 	}
 }
 
+func isMetadataContainer(name string) bool {
+	n := strings.ToLower(strings.TrimSpace(name))
+	return strings.Contains(n, "metadata") || strings.Contains(n, "context") || strings.Contains(n, "session") || strings.Contains(n, "thread")
+}
+
+func hashTraceString(s string) string {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return ""
+	}
+	digest := sha256.Sum256([]byte(s))
+	return fmt.Sprintf("hash:%x", digest[:8])
+}
+
+func hashTraceValue(value any) any {
+	switch v := value.(type) {
+	case string:
+		return hashTraceString(v)
+	case []byte:
+		return hashTraceString(string(v))
+	case map[string]any:
+		out := make(map[string]any, len(v))
+		for k, val := range v {
+			out[k] = hashTraceValue(val)
+		}
+		return out
+	case []any:
+		out := make([]any, len(v))
+		for i, val := range v {
+			out[i] = hashTraceValue(val)
+		}
+		return out
+	default:
+		b, err := json.Marshal(v)
+		if err == nil {
+			return hashTraceString(string(b))
+		}
+		return hashTraceString(fmt.Sprintf("%v", v))
+	}
+}
+
 func publicTracePayloadField(name string) bool {
 	name = strings.ToLower(strings.TrimSpace(name))
 	switch name {
