+func addHeaderView(fields log.Fields, headers http.Header) {
+	if len(headers) == 0 {
+		return
+	}
+	keys := make([]string, 0, len(headers))
+	for key := range headers {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	parts := make([]string, 0, len(keys))
+	for _, key := range keys {
+		value := ""
+		if sensitiveTraceField(key) {
+			value = "<redacted>"
+		} else if publicTraceHeader(key) {
+			value = strings.Join(headers.Values(key), ", ")
+		} else {
+			continue
+		}
+		parts = append(parts, fmt.Sprintf("%s=%q", key, value))
+	}
+	fields["headers"] = strings.Join(parts, " ")
+}
+
+func publicTraceHeader(name string) bool {
+	switch strings.ToLower(strings.TrimSpace(name)) {
+	case "accept", "content-type", "user-agent", "x-request-id", "request-id",
+		"x-correlation-id", "correlation-id", "x-codex-turn-state", "x-models-etag",
+		"openai-beta":
+		return true
+	default:
+		return false
+	}
+}
+
+func safeURLHost(rawURL string) string {
