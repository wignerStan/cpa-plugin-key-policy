-func bytesTrimSpace(b []byte) []byte {
-	return []byte(strings.TrimSpace(string(b)))
+func makeRoomForCodexDump(dir string, incoming int64) (int, error) {
+	if incoming > maxCodexDumpTotalBytes {
+		return 0, fmt.Errorf("capture is %d bytes; total capture limit is %d bytes", incoming, maxCodexDumpTotalBytes)
+	}
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return 0, fmt.Errorf("read private capture directory: %w", err)
+	}
+	type artifact struct {
+		path    string
+		size    int64
+		modTime time.Time
+	}
+	var files []artifact
+	var total int64
+	for _, entry := range entries {
+		if entry.Type()&os.ModeSymlink != 0 || !strings.HasSuffix(entry.Name(), ".raw") {
+			continue
+		}
+		info, err := entry.Info()
+		if err != nil || !info.Mode().IsRegular() {
+			continue
+		}
+		files = append(files, artifact{filepath.Join(dir, entry.Name()), info.Size(), info.ModTime()})
+		total += info.Size()
+	}
+	if total+incoming <= maxCodexDumpTotalBytes {
+		return 0, nil
+	}
+	sort.Slice(files, func(i, j int) bool { return files[i].modTime.Before(files[j].modTime) })
+	pruned := 0
+	for _, file := range files {
+		if total+incoming <= maxCodexDumpTotalBytes {
+			break
+		}
+		if err := os.Remove(file.path); err != nil {
+			return pruned, fmt.Errorf("prune old raw capture artifact: %w", err)
+		}
+		total -= file.size
+		pruned++
+	}
+	if total+incoming > maxCodexDumpTotalBytes {
+		return pruned, errors.New("private capture size limit could not be enforced")
+	}
+	return pruned, nil
+}
+
+func safeCaptureLeg(leg string) string {
+	var b strings.Builder
+	for _, r := range strings.TrimSpace(leg) {
+		if r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r >= '0' && r <= '9' || r == '-' || r == '_' {
+			b.WriteRune(r)
+		}
+	}
+	if b.Len() == 0 {
+		return "unknown"
+	}
+	return b.String()
+}
+
+func addPayloadView(fields log.Fields, payload []byte) {
+	if len(payload) == 0 {
+		return
+	}
+	var value any
+	if err := json.Unmarshal(payload, &value); err != nil {
+		return
+	}
+	var buffer bytes.Buffer
+	encoder := json.NewEncoder(&buffer)
+	encoder.SetEscapeHTML(false)
+	if err := encoder.Encode(classifiedTraceView(value)); err != nil {
+		return
+	}
+	view := bytes.TrimSpace(buffer.Bytes())
+	if len(view) > maxCodexDumpViewBytes {
+		fields["payload_view_omitted"] = "view-size-limit"
+		return
+	}
+	fields["payload_view"] = string(view)
+}
+
+func classifiedTraceView(value any) any {
+	switch typed := value.(type) {
+	case map[string]any:
+		redacted := make(map[string]any, len(typed))
+		for key, item := range typed {
+			if sensitiveTraceField(key) {
+				redacted[key] = "<redacted>"
+			} else if publicTracePayloadField(key) {
+				redacted[key] = classifiedTraceView(item)
+			}
+		}
+		return redacted
+	case []any:
+		redacted := make([]any, len(typed))
+		for i, item := range typed {
+			redacted[i] = classifiedTraceView(item)
+		}
+		return redacted
+	default:
+		return value
+	}
 }
 
