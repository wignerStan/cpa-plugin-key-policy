diff --git a/sdk/protocol/codex/attribution_test.go b/sdk/protocol/codex/attribution_test.go
new file mode 100644
index 0000000..ae74aa7
--- /dev/null
+++ b/sdk/protocol/codex/attribution_test.go
@@ -0,0 +1,45 @@
+package codex
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestValidationPreservesUnknownWritesAndCallerRows(t *testing.T) {
+	row := CacheRow{Input: 10, Cached: 5, Content: []CacheRow{
+		{Input: 4, Cached: 4, WriteKnown: true},
+		{Input: 6, Cached: 1, Written: 2, WriteKnown: true},
+	}}
+	before := row
+	before.Content = append([]CacheRow(nil), row.Content...)
+	if !ValidRow(row) {
+		t.Fatal("unknown parent writes must not contradict known child writes")
+	}
+	details := CacheDetails{Input: 10, Cached: 5, Items: map[string]CacheRow{"item": row}}
+	if !ValidDetails(details) {
+		t.Fatal("a complete partition can retain unknown total writes")
+	}
+	zero := 0
+	details.Written = &zero
+	if ValidDetails(details) {
+		t.Fatal("known zero total writes conflict with the known child writes")
+	}
+	two := 2
+	details.Written = &two
+	if !ValidDetails(details) {
+		t.Fatal("the matching known total was rejected")
+	}
+	three := 3
+	details.Written = &three
+	if ValidDetails(details) {
+		t.Fatal("a complete child partition cannot hide extra writes")
+	}
+	known := row
+	known.WriteKnown = true
+	if ValidRow(known) {
+		t.Fatal("known zero parent writes conflict with the known child writes")
+	}
+	if !reflect.DeepEqual(row, before) {
+		t.Fatal("validation changed caller-owned decoded evidence")
+	}
+}
