index 0000000..9e1e1ad
--- /dev/null
+++ b/sdk/protocol/codexwire/write_bounds_test.go
@@ -0,0 +1,48 @@
+package codexwire
+
+import (
+	"encoding/json"
+	"fmt"
+	"testing"
+)
+
+func TestNestedWriteBoundsCheckKnownClaimsWithoutFillingUnknowns(t *testing.T) {
+	full := `{"input_tokens":10,"cached_tokens":5,"content":[{"input_tokens":4,"cached_tokens":4,"cache_write_tokens":0},{"input_tokens":6,"cached_tokens":1,"cache_write_tokens":2}]}`
+	nested := `{"input_tokens":10,"cached_tokens":5,"content":[` + full + `]}`
+	partial := `{"input_tokens":10,"cached_tokens":2,"content":[{"input_tokens":6,"cached_tokens":1,"cache_write_tokens":2}]}`
+	var absent Usage
+	rawAbsent := fmt.Sprintf(`{"input_tokens":10,"input_tokens_details":{"cached_tokens":5},"attribution":{"items":{"item":%s}}}`, full)
+	if err := json.Unmarshal([]byte(rawAbsent), &absent); err != nil {
+		t.Fatal(err)
+	}
+	if absent.Validate() != nil || absent.Written != nil {
+		t.Fatal("derived bounds became reported aggregate writes")
+	}
+	decoded, ok := AttributionRow(json.RawMessage(full), true)
+	if !ok || decoded.WriteKnown || decoded.Written != 0 {
+		t.Fatal("derived bounds became reported parent-row writes")
+	}
+	for _, tc := range []struct {
+		name   string
+		cached int
+		row    string
+		claims map[int]bool
+	}{
+		{"complete", 5, full, map[int]bool{0: false, 2: true, 3: false}},
+		{"nested_unknown", 5, nested, map[int]bool{0: false, 2: true, 3: false}},
+		{"partial", 2, partial, map[int]bool{1: false, 2: true, 3: true, 5: true, 6: false}},
+	} {
+		for writes, want := range tc.claims {
+			t.Run(fmt.Sprintf("%s/%d", tc.name, writes), func(t *testing.T) {
+				raw := fmt.Sprintf(`{"input_tokens":10,"input_tokens_details":{"cached_tokens":%d,"cache_write_tokens":%d},"attribution":{"items":{"item":%s}}}`, tc.cached, writes, tc.row)
+				var u Usage
+				if err := json.Unmarshal([]byte(raw), &u); err != nil {
+					t.Fatal(err)
+				}
+				if got := u.Validate() == nil; got != want {
+					t.Fatalf("valid=%v want=%v error=%v", got, want, u.Validate())
+				}
+			})
+		}
+	}
+}
