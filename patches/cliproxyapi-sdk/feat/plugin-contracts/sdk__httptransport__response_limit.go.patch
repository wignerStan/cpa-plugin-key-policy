From: CPA patch maintainer <cpa-patches@localhost>
Date: Mon, 19 Oct 2026 08:00:00 -0700
Subject: [PATCH] fix(guard): bound held execution
 (sdk/httptransport/response_limit.go)

---
 sdk/httptransport/response_limit.go | 90 +++++++++++++++++++++++++++++
 1 file changed, 90 insertions(+)
 create mode 100644 sdk/httptransport/response_limit.go

diff --git a/sdk/httptransport/response_limit.go b/sdk/httptransport/response_limit.go
new file mode 100644
index 0000000000000000000000000000000000000000..cba058214ca7a73a5ecfa0c5ddd2a8212159137e
--- /dev/null
+++ b/sdk/httptransport/response_limit.go
@@ -0,0 +1,90 @@
+package httptransport
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"sync"
+)
+
+// ErrResponseBodyTooLarge reports a response body that exceeded its byte budget.
+var ErrResponseBodyTooLarge = errors.New("upstream response body exceeds byte limit")
+
+// WithResponseBodyLimit adds a byte bound to each HTTP response body. It wraps
+// the selected transport and preserves existing decorators. The bound applies
+// to bytes read from resp.Body, after the transport's normal decompression.
+// Zero or negative limits leave the context unchanged. Overflow closes the body
+// and returns an error, rather than a successful truncated EOF.
+func WithResponseBodyLimit(ctx context.Context, limit int64) context.Context {
+	if limit <= 0 {
+		return ctx
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	previous, _ := ctx.Value(decoratorKey{}).(Decorator)
+	return WithDecorator(ctx, func(next http.RoundTripper) http.RoundTripper {
+		if previous != nil {
+			if wrapped := previous(next); wrapped != nil {
+				next = wrapped
+			}
+		}
+		return responseLimitTransport{next: next, limit: limit}
+	})
+}
+
+type responseLimitTransport struct {
+	next  http.RoundTripper
+	limit int64
+}
+
+func (t responseLimitTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	response, err := t.next.RoundTrip(req)
+	if err == nil && response != nil && response.Body != nil {
+		response.Body = &limitedResponseBody{body: response.Body, ctx: req.Context(), remaining: t.limit}
+	}
+	return response, err
+}
+
+type limitedResponseBody struct {
+	body      io.ReadCloser
+	ctx       context.Context
+	remaining int64
+	overflow  bool
+	closeOnce sync.Once
+	closeErr  error
+}
+
+func (b *limitedResponseBody) Read(p []byte) (int, error) {
+	if err := b.ctx.Err(); err != nil {
+		return 0, err
+	}
+	if b.overflow {
+		return 0, ErrResponseBodyTooLarge
+	}
+	if len(p) == 0 {
+		return 0, nil
+	}
+	if b.remaining == 0 {
+		var probe [1]byte
+		n, err := b.body.Read(probe[:])
+		if n > 0 {
+			b.overflow = true
+			_ = b.Close()
+			return 0, ErrResponseBodyTooLarge
+		}
+		return 0, err
+	}
+	if int64(len(p)) > b.remaining {
+		p = p[:b.remaining]
+	}
+	n, err := b.body.Read(p)
+	b.remaining -= int64(n)
+	return n, err
+}
+
+func (b *limitedResponseBody) Close() error {
+	b.closeOnce.Do(func() { b.closeErr = b.body.Close() })
+	return b.closeErr
+}
